# ==============================================================================
# AtlasCovoit Maroc — Exemple de configuration (.env.example)
# ==============================================================================
# Copiez ce fichier en .env.local pour vos surcharges locales (non versionnées).
# Aucun secret réel ne doit être commité dans le dépôt.
# Si APP_SECRET est laissé vide, docker/php/entrypoint.sh génère automatiquement
# un secret aléatoire de 64 caractères dans .env.local au premier démarrage.
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> ports docker compose (optionnel) ###
# Port HTTP exposé par Nginx sur la machine hôte (défaut : 8088 pour éviter les conflits sur 8080)
NGINX_PORT=8088
# Port HTTP exposé par phpMyAdmin en dev (défaut : 8081)
PMA_PORT=8081
# Port TCP exposé par MySQL 8.0 sur la machine hôte (défaut : 3308)
MYSQL_HOST_PORT=3308
###< ports docker compose ###

###> mysql container credentials (dev local uniquement) ###
MYSQL_DATABASE=covoiturage
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
###< mysql container credentials ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8088
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@database:3306/covoiturage?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
