# ==============================================================================
# AtlasCovoit Maroc — Configuration d'exemple (.env.example)
# Copiez ce fichier en .env.local pour vos surcharges locales (non versionnées).
# Aucun secret réel ne doit jamais être commité dans le dépôt.
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
# Laissez vide en dev : généré automatiquement par docker/php/entrypoint.sh
# ou surchargé par la valeur publique de dev dans compose.yaml.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> ports-docker-hote ###
# Ports exposés sur la machine hôte (modifiables en cas de conflit de port)
NGINX_PORT=8088
PMA_PORT=8081
MYSQL_HOST_PORT=3308
###< ports-docker-hote ###

###> mysql-docker ###
MYSQL_DATABASE=covoiturage
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
###< mysql-docker ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8088
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@database:3306/covoiturage?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
