{% extends 'base.html.twig' %}

{% block title %}404 Page introuvable — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="error-stage">
    <div>
        <div class="error-code" data-text="404">404</div>

        <div class="error-road" aria-hidden="true">
            <div class="error-road__car">
                <i class="bi bi-car-front-fill"></i>
            </div>
            <div class="error-road__sign">?</div>
            <div class="error-road__line"></div>
        </div>

        <h1 class="h2 fw-extrabold mb-2">
            Cette étape ne figure sur <span class="text-highlight-lime">aucun itinéraire</span>
        </h1>
        <p class="text-muted mx-auto mb-4" style="max-width: 520px;">
            La page ou le trajet que vous recherchez n'existe pas ou a été déplacé. Reprenez la route principale vers nos trajets régionaux au Maroc.
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a href="{{ path('app_home') }}" class="btn btn-lime px-4 py-2">
                <i class="bi bi-compass me-1" aria-hidden="true"></i>Rechercher un trajet
            </a>
            {% if app.user %}
                <a href="{{ path('app_my_bookings') }}" class="btn btn-outline-light px-4 py-2">
                    <i class="bi bi-ticket-perforated me-1" aria-hidden="true"></i>Mes réservations
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
