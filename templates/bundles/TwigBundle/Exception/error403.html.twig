{% extends 'base.html.twig' %}

{% block title %}403 Accès refusé — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="error-stage">
    <div>
        <div class="lock-art" aria-hidden="true">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <div class="error-code" data-text="403">403</div>

        <h1 class="h2 fw-extrabold mt-3 mb-2">
            Accès <span class="text-highlight-lime">réservé</span> au propriétaire ou à l'administrateur
        </h1>
        <p class="text-muted mx-auto mb-4" style="max-width: 540px;">
            Vous ne disposez pas des droits nécessaires pour effectuer cette opération (protection par Voter Symfony : seul le propriétaire de la ressource ou un administrateur est autorisé).
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a href="{{ path('app_home') }}" class="btn btn-lime px-4 py-2">
                <i class="bi bi-house-door-fill me-1" aria-hidden="true"></i>Retour à l'accueil
            </a>
            {% if not app.user %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-light px-4 py-2">
                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Se connecter
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
