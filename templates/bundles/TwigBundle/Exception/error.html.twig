{% extends 'base.html.twig' %}

{% block title %}Erreur serveur — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="error-stage">
    <div>
        <div class="gear-art" aria-hidden="true">
            <i class="bi bi-gear-fill gear-1"></i>
            <i class="bi bi-gear-fill gear-2"></i>
        </div>

        <div class="error-code" data-text="{{ status_code|default(500) }}">{{ status_code|default(500) }}</div>

        <h1 class="h2 fw-extrabold mt-3 mb-2">
            Incident technique <span class="text-highlight-lime">temporaire</span>
        </h1>
        <p class="text-muted mx-auto mb-4" style="max-width: 520px;">
            Une erreur inattendue est survenue lors du traitement de votre requête. Vos réservations et transactions sont protégées.
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a href="{{ path('app_home') }}" class="btn btn-lime px-4 py-2">
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
