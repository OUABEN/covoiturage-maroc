{% extends 'base.html.twig' %}

{% block title %}Trajet {{ stops|first.city.name }} → {{ stops|last.city.name }} (#{{ trip.id }}) — AtlasCovoit Maroc{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="">
{% endblock %}

{% block javascripts %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""
            defer></script>
{% endblock %}

{% block body %}
{# Prepare JSON payloads for Stimulus trip-map & booking-calculator controllers #}
{% set mapStops = [] %}
{% set calcSegments = [] %}
{% for i, stop in stops %}
    {% set mapStops = mapStops|merge([{
        cityId: stop.city.id,
        name: stop.city.name,
        lat: stop.city.latitude,
        lon: stop.city.longitude,
        stopOrder: stop.stopOrder,
        departureTime: stop.departureTime ? stop.departureTime|date('d/m/Y H:i') : null,
        arrivalTime: stop.arrivalTime ? stop.arrivalTime|date('d/m/Y H:i') : null,
        priceFromPrevious: stop.priceFromPrevious
    }]) %}
    {% if i > 0 %}
        {% set calcSegments = calcSegments|merge([{
            index: i - 1,
            price: stop.priceFromPrevious,
            available: segmentAvailabilities[i - 1] ?? 0
        }]) %}
    {% endif %}
{% endfor %}

<div class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm px-3 py-2 text-decoration-none">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à la recherche
    </a>
    <div class="d-flex align-items-center gap-2">
        {% if trip.status.value == 'PUBLISHED' %}
            <span class="badge badge-lime">
                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Trajet publié · Réservation ouverte
            </span>
        {% elseif trip.status.value == 'COMPLETED' %}
            <span class="badge badge-surface">
                <i class="bi bi-flag-fill me-1" aria-hidden="true"></i>Trajet terminé
            </span>
        {% else %}
            <span class="badge badge-danger-soft">
                <i class="bi bi-x-circle-fill me-1" aria-hidden="true"></i>Trajet annulé
            </span>
        {% endif %}
        <span class="badge badge-surface">
            <i class="bi bi-people-fill me-1" aria-hidden="true"></i>Capacité max : {{ trip.seatsTotal }} places
        </span>
    </div>
</div>

<div class="row g-4">
    {# Left Column: Route Header, Interactive Leaflet Map, Vertical Timeline, Driver & Vehicle #}
    <div class="col-lg-7">
        {# Route Summary Header Card #}
        <div class="card mb-4 overflow-hidden">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-4 d-none d-md-block">
                    {% include 'components/city_image.html.twig' with {
                        cityName: stops|last.city.name,
                        height: 185,
                        class: 'w-100 h-100 object-fit-cover d-block'
                    } %}
                </div>
                <div class="col-md-8">
                    <div class="card-body p-4 d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="small text-muted fw-semibold text-uppercase mb-1">
                                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                                Départ initial le {{ stops|first.departureTime|date('d/m/Y à H:i') }}
                            </div>
                            <h1 class="h3 fw-extrabold mb-2">
                                {{ stops|first.city.name }}
                                <span class="mx-2" style="color: var(--accent);">&rarr;</span>
                                <span class="text-highlight-lime">{{ stops|last.city.name }}</span>
                            </h1>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
                            {% for idx, s in stops %}
                                <span class="badge badge-surface small">
                                    {{ idx + 1 }}. {{ s.city.name }}
                                </span>
                                {% if not loop.last %}
                                    <i class="bi bi-chevron-right small text-muted" aria-hidden="true"></i>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Interactive Leaflet Map powered by /api/route #}
        <div class="card mb-4"
             data-controller="trip-map"
             data-trip-map-stops-value="{{ mapStops|json_encode|e('html_attr') }}"
             data-trip-map-route-endpoint-value="{{ path('api_route_estimate') }}">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-extrabold mb-0">
                            <i class="bi bi-map-fill me-2" aria-hidden="true"></i>Carte de l'itinéraire multi-étapes
                        </h2>
                        <p class="small text-muted mb-0">
                            Tracé routier OSRM temps réel (<code class="small">/api/route</code>) · Bascule dynamique sombre/clair
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge badge-lime" data-trip-map-target="distance">
                            <i class="bi bi-signpost-split-fill me-1" aria-hidden="true"></i>Calcul OSRM…
                        </span>
                        <span class="badge badge-surface" data-trip-map-target="duration">
                            <i class="bi bi-stopwatch-fill me-1" aria-hidden="true"></i>—
                        </span>
                    </div>
                </div>

                <div class="trip-map-container"
                     data-trip-map-target="canvas"
                     role="region"
                     aria-label="Carte interactive du trajet de {{ stops|first.city.name }} à {{ stops|last.city.name }}">
                </div>
            </div>
        </div>

        {# Vertical Timeline of Stops & Segments #}
        <div class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="h5 fw-extrabold mb-1">Itinéraire détaillé et segments</h2>
                        <p class="small text-muted mb-0">
                            Tarif et disponibilité calculés indépendamment sur chaque tronçon.
                        </p>
                    </div>
                    <span class="badge badge-surface">{{ stops|length }} étapes</span>
                </div>

                <div class="timeline-vertical">
                    {% for i, stop in stops %}
                        {% set isEndpoint = loop.first or loop.last %}
                        <div class="timeline-stop-item">
                            <div class="timeline-marker {{ isEndpoint ? 'timeline-marker-endpoint' : '' }}">
                                {{ stop.stopOrder + 1 }}
                            </div>

                            <div class="timeline-stop-card">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <strong class="fs-5 fw-extrabold">{{ stop.city.name }}</strong>
                                            {% if loop.first %}
                                                <span class="badge badge-lime">Départ initial</span>
                                            {% elseif loop.last %}
                                                <span class="badge badge-lime">Terminus</span>
                                            {% else %}
                                                <span class="badge badge-surface">Étape {{ stop.stopOrder + 1 }}</span>
                                            {% endif %}
                                        </div>

                                        <div class="d-flex flex-wrap gap-3 small text-muted mt-1">
                                            {% if stop.arrivalTime %}
                                                <span>
                                                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                                                    Arrivée : <strong class="text-white">{{ stop.arrivalTime|date('d/m/Y H:i') }}</strong>
                                                </span>
                                            {% endif %}
                                            {% if stop.departureTime %}
                                                <span>
                                                    <i class="bi bi-play-circle-fill me-1" aria-hidden="true"></i>
                                                    Départ : <strong class="text-white">{{ stop.departureTime|date('d/m/Y H:i') }}</strong>
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {% if i > 0 %}
                                        {% set segAvail = segmentAvailabilities[i - 1] ?? 0 %}
                                        <div class="text-md-end">
                                            <span class="badge badge-lime mb-1">
                                                Segment depuis {{ stops[i - 1].city.name }} : {{ stop.priceFromPrevious }} MAD
                                            </span>
                                            <div class="small text-muted mt-1">
                                                Places libres sur ce segment :
                                                <strong class="text-white">{{ segAvail }} / {{ trip.seatsTotal }}</strong>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Driver & Vehicle Card #}
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h5 fw-extrabold mb-3">Conducteur &amp; Véhicule</h2>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-initials" style="width: 52px; height: 52px; font-size: 1.1rem;" aria-hidden="true">
                            {{ trip.driver.firstName|slice(0, 1)|upper }}{{ trip.driver.lastName|slice(0, 1)|upper }}
                        </div>
                        <div>
                            <div class="fw-extrabold fs-5">
                                <a href="{{ path('app_profile_show', {id: trip.driver.id}) }}" class="text-decoration-none">
                                    {{ trip.driver.fullName }}
                                    <i class="bi bi-arrow-up-right-circle ms-1 small" aria-hidden="true"></i>
                                </a>
                            </div>
                            <div class="mt-1">
                                {% include 'components/rating.html.twig' with {
                                    average: driverRating.average,
                                    count: driverRating.count
                                } %}
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--surface-2); border: 1px solid var(--border);">
                        {% include 'components/car_image.html.twig' with {
                            label: trip.vehicle.brand ~ ' ' ~ trip.vehicle.model,
                            displayHeight: 42
                        } %}
                        <div>
                            <div class="fw-bold">
                                {{ trip.vehicle.brand }} {{ trip.vehicle.model }}
                            </div>
                            <div class="small text-muted">
                                Couleur : {{ trip.vehicle.color }} · {{ trip.vehicle.seats }} places max
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Right Column: Sticky Booking Sidebar with Live Stimulus Calculator #}
    <div class="col-lg-5">
        <div class="card sticky-top"
             style="top: 5.5rem;"
             data-controller="booking-calculator"
             data-booking-calculator-segments-value="{{ calcSegments|json_encode|e('html_attr') }}">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 fw-extrabold mb-0">Réserver une portion</h2>
                    <span class="badge badge-lime">Instant</span>
                </div>

                {# Selected Portion Live Summary #}
                <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center"
                     style="background-color: var(--surface-2); border: 1px solid var(--border);">
                    <div>
                        <div class="small text-muted">Portion sélectionnée</div>
                        <div class="fw-extrabold fs-5" data-booking-calculator-target="portionLabel">
                            {{ selectedFrom.city.name }} &rarr; {{ selectedTo.city.name }}
                        </div>
                        <div class="mt-1">
                            <span class="badge badge-lime" data-booking-calculator-target="availableSeats">
                                {{ portionAvailableSeats }} place(s) disponible(s)
                            </span>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fs-4 fw-extrabold" data-booking-calculator-target="unitPrice">
                            {{ portionUnitPrice }} MAD
                        </div>
                        <div class="small text-muted">par place</div>
                    </div>
                </div>

                {% if trip.status.value != 'PUBLISHED' %}
                    <div class="alert alert-secondary mb-3">
                        <i class="bi bi-lock-fill me-1" aria-hidden="true"></i>
                        Ce trajet n'est plus ouvert à la réservation.
                    </div>
                {% elseif app.user %}
                    <form method="post" action="{{ path('app_trip_book', {id: trip.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('book_trip_' ~ trip.id) }}">

                        <div class="mb-3">
                            <label for="from_stop" class="form-label">
                                <i class="bi bi-record-circle me-1" aria-hidden="true"></i>Ville de montée
                            </label>
                            <select name="from_stop"
                                    id="from_stop"
                                    class="form-select"
                                    required
                                    data-booking-calculator-target="fromSelect"
                                    data-action="change->booking-calculator#recalculate">
                                {% for stop in stops|slice(0, stops|length - 1) %}
                                    <option value="{{ stop.id }}"
                                            data-stop-order="{{ stop.stopOrder }}"
                                            data-city-name="{{ stop.city.name }}"
                                            {{ selectedFrom and selectedFrom.id == stop.id ? 'selected' : '' }}>
                                        {{ stop.stopOrder + 1 }}. {{ stop.city.name }} ({{ stop.departureTime|date('H:i') }})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="to_stop" class="form-label">
                                <i class="bi bi-geo-alt-fill me-1" aria-hidden="true"></i>Ville de descente
                            </label>
                            <select name="to_stop"
                                    id="to_stop"
                                    class="form-select"
                                    required
                                    data-booking-calculator-target="toSelect"
                                    data-action="change->booking-calculator#recalculate">
                                {% for stop in stops|slice(1) %}
                                    <option value="{{ stop.id }}"
                                            data-stop-order="{{ stop.stopOrder }}"
                                            data-city-name="{{ stop.city.name }}"
                                            {{ selectedTo and selectedTo.id == stop.id ? 'selected' : '' }}>
                                        {{ stop.stopOrder + 1 }}. {{ stop.city.name }} ({{ (stop.arrivalTime ?? stop.departureTime)|date('H:i') }} — +{{ stop.priceFromPrevious }} MAD)
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="seats" class="form-label">
                                <i class="bi bi-person-plus-fill me-1" aria-hidden="true"></i>Nombre de places
                            </label>
                            <input type="number"
                                   name="seats"
                                   id="seats"
                                   class="form-control"
                                   min="1"
                                   max="{{ trip.seatsTotal }}"
                                   value="1"
                                   required
                                   data-booking-calculator-target="seatsInput"
                                   data-action="input->booking-calculator#recalculate change->booking-calculator#recalculate">
                        </div>

                        {# Live Total Price Recalculated Box #}
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3"
                             style="background-color: var(--surface-2); border: 1px dashed var(--accent);">
                            <span class="small fw-bold text-uppercase">Total à régler</span>
                            <span class="fs-4 fw-extrabold text-highlight-lime" data-booking-calculator-target="totalPrice">
                                {{ portionUnitPrice }} MAD
                            </span>
                        </div>

                        <button type="submit" class="btn btn-lime w-100 py-3">
                            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Confirmer la réservation
                        </button>
                    </form>
                {% else %}
                    <div class="alert alert-info mb-3 small">
                        <i class="bi bi-info-circle-fill me-1" aria-hidden="true"></i>
                        Connectez-vous pour réserver votre place sur ce trajet.
                    </div>
                    <a href="{{ path('app_login') }}" class="btn btn-lime w-100 py-2">
                        Se connecter pour réserver
                    </a>
                {% endif %}

                {# Refund Policy Reminder #}
                <div class="mt-4 pt-3 border-top">
                    <div class="small fw-extrabold text-uppercase mb-2">
                        <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Politique de remboursement garantie
                    </div>
                    <ul class="list-unstyled small text-muted mb-0 d-grid gap-1">
                        <li><strong class="text-white">100 % remboursé</strong> si annulation plus de 24h avant le départ.</li>
                        <li><strong class="text-white">50 % remboursé</strong> entre 2h et 24h avant le départ.</li>
                        <li><strong class="text-white">0 %</strong> à moins de 2h du départ.</li>
                        <li><strong class="text-white">100 % intégral</strong> si les horaires du trajet ont été décalés de plus de 30 min.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
