{% extends 'base.html.twig' %}

{% block title %}Espace Conducteur — Mes trajets — AtlasCovoit Maroc{% endblock %}

{% block body %}
{# Compute Driver KPIs (total confirmed passengers & total revenue across trips) #}
{% set totalConfirmedPassengers = 0 %}
{% set totalEstimatedRevenue = 0 %}
{% for t in publishedTrips|merge(historyTrips) %}
    {% for b in t.bookings %}
        {% if b.status.value == 'CONFIRMED' %}
            {% set totalConfirmedPassengers = totalConfirmedPassengers + b.seats %}
            {% set totalEstimatedRevenue = totalEstimatedRevenue + b.price %}
        {% endif %}
    {% endfor %}
{% endfor %}

<div class="page-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="eyebrow">Espace Conducteur</div>
            <h1 class="fw-extrabold mb-2">
                Tableau de bord &amp; <span class="text-highlight-lime">trajets publiés</span>
            </h1>
            <p class="text-muted mb-0" style="max-width: 640px;">
                Pilotez vos itinéraires multi-étapes, consultez les passagers inscrits sur chaque tronçon, ajustez un horaire d'étape ou clôturez un voyage terminé.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_my_vehicles') }}" class="btn btn-outline-light">
                <i class="bi bi-car-front-fill me-1" aria-hidden="true"></i>Mes véhicules ({{ vehicles|length }})
            </a>
            <a href="{{ path('app_trip_new') }}" class="btn btn-lime">
                <i class="bi bi-plus-circle-fill me-1" aria-hidden="true"></i>Publier un nouveau trajet
            </a>
        </div>
    </div>

    {# KPI Row with Animated Counters #}
    <div class="row g-3 mt-3">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Trajets actifs</span>
                    <span class="icon-chip"><i class="bi bi-broadcast-pin" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value" data-controller="counter" data-counter-target-value="{{ publishedTrips|length }}">
                    {{ publishedTrips|length }}
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Places réservées</span>
                    <span class="icon-chip icon-chip--ghost"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value" data-controller="counter" data-counter-target-value="{{ totalConfirmedPassengers }}">
                    {{ totalConfirmedPassengers }}
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Revenus confirmés</span>
                    <span class="icon-chip"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value"
                     data-controller="counter"
                     data-counter-target-value="{{ totalEstimatedRevenue }}"
                     data-counter-suffix-value=" MAD">
                    {{ totalEstimatedRevenue|number_format(0, ',', ' ') }} MAD
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Véhicules enregistrés</span>
                    <span class="icon-chip icon-chip--ghost"><i class="bi bi-car-front-fill" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value" data-controller="counter" data-counter-target-value="{{ vehicles|length }}">
                    {{ vehicles|length }}
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
    </div>
</div>

{# Segmented Tabs for Published vs History #}
<div data-controller="tabs">
    <div class="seg-tabs" role="tablist" aria-label="Filtrer mes trajets conducteur" data-action="keydown->tabs#keydown">
        <span class="seg-tabs__indicator" data-tabs-target="indicator" aria-hidden="true"></span>

        <button type="button"
                class="seg-tab"
                role="tab"
                aria-selected="true"
                tabindex="0"
                data-tabs-target="tab"
                data-action="click->tabs#select">
            <i class="bi bi-broadcast" aria-hidden="true"></i>
            <span>Trajets publiés</span>
            <span class="count-pill">{{ publishedTrips|length }}</span>
        </button>

        <button type="button"
                class="seg-tab"
                role="tab"
                aria-selected="false"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select">
            <i class="bi bi-archive" aria-hidden="true"></i>
            <span>Historique</span>
            <span class="count-pill">{{ historyTrips|length }}</span>
        </button>
    </div>

    {# PANEL 1: PUBLISHED TRIPS #}
    <section class="seg-panel is-entering" role="tabpanel" data-tabs-target="panel">
        <h2 class="section-title">
            <i class="bi bi-broadcast" style="color: var(--accent);" aria-hidden="true"></i>
            <span>Trajets publiés</span>
            <span class="count-pill">{{ publishedTrips|length }}</span>
        </h2>

        {% if publishedTrips is empty %}
            <div class="card mb-5">
                <div class="empty-state">
                    <div class="empty-state__art" aria-hidden="true">
                        <i class="bi bi-signpost-split"></i>
                    </div>
                    <h3 class="h5 fw-extrabold mb-1">Aucun trajet actif publié</h3>
                    <p class="text-muted small mb-3">
                        Publiez votre prochain itinéraire multi-étapes et partagez vos frais de route.
                    </p>
                    <a href="{{ path('app_trip_new') }}" class="btn btn-lime btn-sm">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Publier un trajet
                    </a>
                </div>
            </div>
        {% else %}
            <div class="vstack gap-4 mb-5">
                {% for trip in publishedTrips %}
                    {% set stops = trip.stops %}
                    {% set confirmedBookings = trip.bookings|filter(b => b.status.value == 'CONFIRMED') %}
                    {% set seatsSold = 0 %}
                    {% set tripRevenue = 0 %}
                    {% for b in confirmedBookings %}
                        {% set seatsSold = seatsSold + b.seats %}
                        {% set tripRevenue = tripRevenue + b.price %}
                    {% endfor %}
                    {% set occPercent = trip.seatsTotal > 0 ? min(100, ((seatsSold / trip.seatsTotal) * 100)|round) : 0 %}

                    <div class="card hover-lift">
                        <div class="card-body p-4">
                            {# Top Header #}
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge badge-lime">
                                            <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Publié
                                        </span>
                                        <span class="badge badge-surface">Trajet #{{ trip.id }}</span>
                                        <span class="badge badge-surface">
                                            <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                                            {{ stops|first.departureTime|date('d/m/Y à H:i') }}
                                        </span>
                                    </div>

                                    {# Animated Route Chain #}
                                    <div class="route-chain my-2">
                                        {% for stop in stops %}
                                            <span class="route-chain__stop">
                                                {{ stop.stopOrder + 1 }}. {{ stop.city.name }}
                                            </span>
                                            {% if not loop.last %}
                                                <span class="route-chain__link" aria-hidden="true"></span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>

                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-car-front me-1" aria-hidden="true"></i>
                                        Véhicule : <strong class="text-white">{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</strong>
                                        &bull; Capacité : <strong class="text-white">{{ trip.seatsTotal }} places</strong>
                                        &bull; Revenu confirmé : <strong class="text-white">{{ tripRevenue|number_format(2, '.', ' ') }} MAD</strong>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Fiche publique
                                    </a>
                                    <form method="post" action="{{ path('app_driver_trip_complete', {id: trip.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('complete_trip_' ~ trip.id) }}">
                                        <button type="submit" class="btn btn-lime btn-sm">
                                            <i class="bi bi-check2-all me-1" aria-hidden="true"></i>Marquer terminé
                                        </button>
                                    </form>
                                    <form method="post"
                                          action="{{ path('app_driver_trip_cancel', {id: trip.id}) }}"
                                          class="d-inline"
                                          data-confirm="Confirmer l'annulation de ce trajet ? Toutes les réservations confirmées seront intégralement remboursées à 100 %."
                                          data-confirm-label="Annuler le trajet">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_trip_' ~ trip.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-x-octagon me-1" aria-hidden="true"></i>Annuler le trajet
                                        </button>
                                    </form>
                                </div>
                            </div>

                            {# Animated Occupancy Bar #}
                            <div class="mb-4">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Taux de réservation ({{ confirmedBookings|length }} réservation(s) active(s))</span>
                                    <strong class="text-white">{{ seatsSold }} place(s) réservée(s) sur les segments</strong>
                                </div>
                                <div class="occupancy">
                                    <div class="occupancy__fill" style="--p: {{ occPercent }}%;"></div>
                                </div>
                            </div>

                            <div class="row g-4">
                                {# Left Column: Collapsible Stop Time Editor #}
                                <div class="col-lg-7">
                                    <details class="stop-editor" open>
                                        <summary>
                                            <span>
                                                <i class="bi bi-clock-history me-2" style="color: var(--accent);" aria-hidden="true"></i>
                                                Étapes &amp; Ajustement d'horaire (tolérance ±30 min)
                                            </span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="stop-editor__body">
                                            {% for stop in stops %}
                                                <div class="stop-editor__row">
                                                    <div>
                                                        <strong>{{ stop.stopOrder + 1 }}. {{ stop.city.name }}</strong>
                                                        {% if stop.stopOrder > 0 %}
                                                            <span class="badge badge-lime ms-1">+{{ stop.priceFromPrevious }} MAD</span>
                                                        {% else %}
                                                            <span class="badge badge-surface ms-1">Départ</span>
                                                        {% endif %}
                                                    </div>
                                                    <form method="post" action="{{ path('app_driver_stop_update_time', {id: stop.id}) }}" class="d-flex flex-wrap align-items-center gap-1">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('update_stop_' ~ stop.id) }}">
                                                        {% if stop.arrivalTime %}
                                                            <input type="datetime-local" name="arrival_time" class="form-control form-control-sm" style="width: auto;" value="{{ stop.arrivalTime|date('Y-m-d\\TH:i') }}" title="Heure d'arrivée">
                                                        {% endif %}
                                                        {% if stop.departureTime %}
                                                            <input type="datetime-local" name="departure_time" class="form-control form-control-sm" style="width: auto;" value="{{ stop.departureTime|date('Y-m-d\\TH:i') }}" title="Heure de départ">
                                                        {% endif %}
                                                        <button type="submit" class="btn btn-outline-light btn-sm">Modifier</button>
                                                    </form>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </details>
                                </div>

                                {# Right Column: Confirmed Passengers per Segment #}
                                <div class="col-lg-5">
                                    <div class="small fw-extrabold text-uppercase text-muted mb-2">
                                        <i class="bi bi-people me-1" aria-hidden="true"></i>
                                        Passagers inscrits par segment ({{ confirmedBookings|length }})
                                    </div>
                                    {% if confirmedBookings is empty %}
                                        <div class="p-3 rounded-3 border text-muted small" style="background-color: var(--surface-2);">
                                            Aucun passager confirmé pour le moment.
                                        </div>
                                    {% else %}
                                        <div class="vstack gap-2">
                                            {% for booking in confirmedBookings %}
                                                <div class="passenger-row">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="avatar-initials" style="width: 36px; height: 36px; font-size: 0.8rem;" aria-hidden="true">
                                                            {{ booking.passenger.firstName|slice(0, 1)|upper }}{{ booking.passenger.lastName|slice(0, 1)|upper }}
                                                        </span>
                                                        <div>
                                                            <a href="{{ path('app_profile_show', {id: booking.passenger.id}) }}" class="fw-bold text-decoration-none">
                                                                {{ booking.passenger.fullName }}
                                                            </a>
                                                            <div class="small text-muted">
                                                                Segment : <strong class="text-white">{{ booking.fromStop.city.name }} &rarr; {{ booking.toStop.city.name }}</strong>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="badge badge-lime">{{ booking.seats }} place(s)</span>
                                                        <div class="small fw-extrabold mt-1">{{ booking.price }} MAD</div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# PANEL 2: HISTORY TRIPS #}
    <section class="seg-panel" role="tabpanel" data-tabs-target="panel">
        <h2 class="section-title">
            <i class="bi bi-archive text-muted" aria-hidden="true"></i>
            <span>Historique des trajets terminés / annulés</span>
            <span class="count-pill">{{ historyTrips|length }}</span>
        </h2>

        {% if historyTrips is empty %}
            <div class="card">
                <div class="empty-state">
                    <div class="empty-state__art" aria-hidden="true">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h3 class="h5 fw-extrabold mb-1">Aucun trajet dans l'historique</h3>
                    <p class="text-muted small mb-0">
                        Les trajets marqués comme terminés ou annulés seront archivés ici.
                    </p>
                </div>
            </div>
        {% else %}
            <div class="vstack gap-3">
                {% for trip in historyTrips %}
                    {% set stops = trip.stops %}
                    <div class="card hover-lift">
                        <div class="card-body p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                {% if trip.status.value == 'COMPLETED' %}
                                    <span class="badge badge-surface">
                                        <i class="bi bi-flag-fill me-1" aria-hidden="true"></i>Terminé
                                    </span>
                                {% else %}
                                    <span class="badge badge-danger-soft">
                                        <i class="bi bi-x-circle-fill me-1" aria-hidden="true"></i>Annulé
                                    </span>
                                {% endif %}
                                <strong class="fs-6">{{ stops|first.city.name }} &rarr; {{ stops|last.city.name }}</strong>
                                <span class="text-muted small">
                                    &bull; {{ stops|first.departureTime|date('d/m/Y à H:i') }}
                                    &bull; {{ stops|length }} étapes
                                </span>
                            </div>
                            <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="btn btn-sm btn-outline-light">
                                Voir le détail <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
