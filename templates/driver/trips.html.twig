{% extends 'base.html.twig' %}

{% block title %}Mes trajets conducteur — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Espace Conducteur — Mes trajets</h1>
        <p class="text-muted small mb-0">
            Gérez vos trajets publiés, consultez les passagers par portion, ajustez un horaire ou marquez un trajet terminé.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_my_vehicles') }}" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-car-front me-1"></i>Mes véhicules ({{ vehicles|length }})
        </a>
        <a href="{{ path('app_trip_new') }}" class="btn btn-brand btn-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i>Publier un nouveau trajet
        </a>
    </div>
</div>

<h2 class="h5 fw-bold mb-3">
    <i class="bi bi-broadcast text-success me-1"></i>Trajets publiés ({{ publishedTrips|length }})
</h2>

{% if publishedTrips is empty %}
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4 text-center text-muted">
            Vous n'avez aucun trajet actif publié actuellement.
        </div>
    </div>
{% else %}
    <div class="row g-4 mb-5">
        {% for trip in publishedTrips %}
            {% set stops = trip.stops %}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                            <div>
                                <span class="badge bg-success mb-1">Publié</span>
                                <h3 class="h5 fw-bold mb-1">
                                    {{ stops|first.city.name }} &rarr; {{ stops|last.city.name }}
                                </h3>
                                <div class="small text-muted">
                                    Véhicule : {{ trip.vehicle.brand }} {{ trip.vehicle.model }} ({{ trip.seatsTotal }} places mises en vente)
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <form method="post" action="{{ path('app_driver_trip_complete', {id: trip.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('complete_trip_' ~ trip.id) }}">
                                    <button type="submit" class="btn btn-success btn-sm fw-semibold">
                                        <i class="bi bi-check2-all me-1"></i>Marquer terminé
                                    </button>
                                </form>
                                <form method="post" action="{{ path('app_driver_trip_cancel', {id: trip.id}) }}" class="d-inline" onsubmit="return confirm('Confirmer l\'annulation de ce trajet ? Tous les passagers seront remboursés à 100 %.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_trip_' ~ trip.id) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold">
                                        <i class="bi bi-x-octagon me-1"></i>Annuler le trajet
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <h4 class="h6 fw-bold text-muted text-uppercase small mb-2">Étapes &amp; Ajustement d'horaire (tolérance ±30 min)</h4>
                                <div class="list-group list-group-flush border rounded">
                                    {% for stop in stops %}
                                        <div class="list-group-item py-2">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div>
                                                    <strong>{{ stop.stopOrder + 1 }}. {{ stop.city.name }}</strong>
                                                    {% if stop.stopOrder > 0 %}
                                                        <span class="badge bg-light text-dark border ms-1">+{{ stop.priceFromPrevious }} MAD</span>
                                                    {% endif %}
                                                </div>
                                                <form method="post" action="{{ path('app_driver_stop_update_time', {id: stop.id}) }}" class="d-flex align-items-center gap-1">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('update_stop_' ~ stop.id) }}">
                                                    {% if stop.arrivalTime %}
                                                        <input type="datetime-local" name="arrival_time" class="form-control form-control-sm" value="{{ stop.arrivalTime|date('Y-m-d\\TH:i') }}" title="Arrivée">
                                                    {% endif %}
                                                    {% if stop.departureTime %}
                                                        <input type="datetime-local" name="departure_time" class="form-control form-control-sm" value="{{ stop.departureTime|date('Y-m-d\\TH:i') }}" title="Départ">
                                                    {% endif %}
                                                    <button type="submit" class="btn btn-outline-primary btn-sm">Modifier</button>
                                                </form>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <h4 class="h6 fw-bold text-muted text-uppercase small mb-2">Passagers inscrits par segment</h4>
                                {% set confirmedBookings = trip.bookings|filter(b => b.status.value == 'CONFIRMED') %}
                                {% if confirmedBookings is empty %}
                                    <div class="p-3 bg-light rounded text-muted small">
                                        Aucun passager confirmé pour le moment.
                                    </div>
                                {% else %}
                                    <ul class="list-group">
                                        {% for booking in confirmedBookings %}
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <a href="{{ path('app_profile_show', {id: booking.passenger.id}) }}" class="fw-semibold text-decoration-none">
                                                        {{ booking.passenger.fullName }}
                                                    </a>
                                                    <div class="small text-muted">
                                                        Segment : <strong>{{ booking.fromStop.city.name }} &rarr; {{ booking.toStop.city.name }}</strong>
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge bg-primary">{{ booking.seats }} place(s)</span>
                                                    <div class="small fw-bold mt-1">{{ booking.price }} MAD</div>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

<h2 class="h5 fw-bold mb-3">
    <i class="bi bi-archive text-secondary me-1"></i>Historique des trajets terminés / annulés ({{ historyTrips|length }})
</h2>

{% if historyTrips is empty %}
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center text-muted">
            Aucun trajet dans l'historique.
        </div>
    </div>
{% else %}
    <div class="row g-3">
        {% for trip in historyTrips %}
            {% set stops = trip.stops %}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge {{ trip.status.value == 'COMPLETED' ? 'bg-secondary' : 'bg-danger' }} me-2">
                                {{ trip.status.value == 'COMPLETED' ? 'Terminé' : 'Annulé' }}
                            </span>
                            <strong>{{ stops|first.city.name }} &rarr; {{ stops|last.city.name }}</strong>
                            <span class="text-muted small ms-2">({{ stops|first.departureTime|date('d/m/Y H:i') }})</span>
                        </div>
                        <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
