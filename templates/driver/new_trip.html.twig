{% extends 'base.html.twig' %}

{% block title %}Publier un trajet — AtlasCovoit Maroc{% endblock %}

{% block body %}
{% set cityOptionsHtml %}
    {% for c in cities %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
{% endset %}

<div class="page-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="eyebrow">Publication assistée par OSRM</div>
            <h1 class="fw-extrabold mb-2">
                Publier un <span class="text-highlight-lime">nouveau trajet</span> multi-étapes
            </h1>
            <p class="text-muted mb-0" style="max-width: 640px;">
                Composez votre itinéraire étape par étape. Le tarif de chaque segment est automatiquement suggéré en temps réel via <code class="small">/api/route</code> (0,60 MAD/km arrondi aux 5 MAD) et reste librement modifiable.
            </p>
        </div>
        <a href="{{ path('app_my_trips') }}" class="btn btn-outline-light">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à mes trajets
        </a>
    </div>
</div>

{% if vehicles is empty %}
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="empty-state">
                    <div class="empty-state__art" aria-hidden="true">
                        <i class="bi bi-car-front"></i>
                    </div>
                    <h2 class="h5 fw-extrabold mb-2">Aucun véhicule enregistré</h2>
                    <p class="text-muted small mb-4">
                        Ajoutez votre véhicule ci-contre (ou depuis votre garage) pour débloquer immédiatement la publication de trajets multi-étapes.
                    </p>
                    <a href="{{ path('app_my_vehicles', {redirect: 'trip_new'}) }}" class="btn btn-lime">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Ajouter un véhicule
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="icon-chip" style="width: 36px; height: 36px; font-size: 1rem;">
                            <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h2 class="h5 fw-extrabold mb-0">Ajout rapide de véhicule</h2>
                            <p class="small text-muted mb-0">Retour automatique vers la publication après création</p>
                        </div>
                    </div>

                    <form method="post" action="{{ path('app_my_vehicles') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('manage_vehicle') }}">
                        <input type="hidden" name="_redirect" value="trip_new">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="quick_brand" class="form-label small">Marque</label>
                                <input type="text" name="brand" id="quick_brand" class="form-control form-control-sm" placeholder="Ex. Dacia" required>
                            </div>
                            <div class="col-md-6">
                                <label for="quick_model" class="form-label small">Modèle</label>
                                <input type="text" name="model" id="quick_model" class="form-control form-control-sm" placeholder="Ex. Duster" required>
                            </div>
                            <div class="col-md-6">
                                <label for="quick_color" class="form-label small">Couleur</label>
                                <input type="text" name="color" id="quick_color" class="form-control form-control-sm" placeholder="Ex. Gris" required>
                            </div>
                            <div class="col-md-6">
                                <label for="quick_seats" class="form-label small">Places passagers (1 à 8)</label>
                                <input type="number" name="seats" id="quick_seats" class="form-control form-control-sm" min="1" max="8" value="4" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-lime w-100 mt-4">
                            <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Enregistrer et publier un trajet
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div data-controller="trip-builder"
         data-trip-builder-route-endpoint-value="{{ path('api_route_estimate') }}"
         data-trip-builder-city-options-html-value="{{ cityOptionsHtml|e('html_attr') }}">

        {# Visual 3-Step Stepper #}
        <div class="builder-steps" aria-label="Étapes de publication">
            <div class="builder-step is-current" data-trip-builder-target="stepIndicator">
                <span class="builder-step__num">1</span>
                <span>Véhicule &amp; Capacité</span>
            </div>
            <div class="builder-step" data-trip-builder-target="stepIndicator">
                <span class="builder-step__num">2</span>
                <span>Étapes &amp; Horaires</span>
            </div>
            <div class="builder-step" data-trip-builder-target="stepIndicator">
                <span class="builder-step__num">3</span>
                <span>Tarifs OSRM &amp; Publication</span>
            </div>
        </div>

        <form method="post" action="{{ path('app_trip_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('publish_trip') }}">

            <div class="row g-4">
                {# Left Column: Form Steps #}
                <div class="col-lg-8">
                    {# Step 1 Card: Vehicle & Seats #}
                    <div class="card mb-4 builder-section">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="icon-chip" style="width: 36px; height: 36px; font-size: 1rem;">
                                    <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <h2 class="h5 fw-extrabold mb-0">1. Véhicule et nombre de places</h2>
                                    <p class="small text-muted mb-0">La capacité vendue ne peut pas dépasser celle du véhicule choisi.</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label for="vehicle_id" class="form-label">Véhicule</label>
                                    <select name="vehicle_id"
                                            id="vehicle_id"
                                            class="form-select"
                                            required
                                            data-trip-builder-target="vehicleSelect"
                                            data-action="change->trip-builder#onVehicleChange">
                                        {% for v in vehicles %}
                                            <option value="{{ v.id }}" data-max-seats="{{ v.seats }}">
                                                {{ v.brand }} {{ v.model }} ({{ v.color }} — max {{ v.seats }} places)
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label for="seats_total" class="form-label">Places mises en vente</label>
                                    <input type="number"
                                           name="seats_total"
                                           id="seats_total"
                                           class="form-control"
                                           min="1"
                                           max="9"
                                           value="{{ min(3, vehicles|first.seats) }}"
                                           required
                                           data-trip-builder-target="seatsInput"
                                           data-action="input->trip-builder#onFieldInput">
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Step 2 & 3 Card: Dynamic Stops & OSRM Pricing #}
                    <div class="card builder-section">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="icon-chip" style="width: 36px; height: 36px; font-size: 1rem;">
                                        <i class="bi bi-signpost-split-fill" aria-hidden="true"></i>
                                    </span>
                                    <div>
                                        <h2 class="h5 fw-extrabold mb-0">2. Étapes du trajet (minimum 2)</h2>
                                        <p class="small text-muted mb-0">Horaires strictement croissants · Tarif par segment auto-calculé via OSRM</p>
                                    </div>
                                </div>
                                <button type="button"
                                        id="add-stop-btn"
                                        class="btn btn-outline-light btn-sm"
                                        data-action="click->trip-builder#addStop">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Ajouter une étape
                                </button>
                            </div>

                            <div id="stops-container" class="stop-list mb-4" data-trip-builder-target="stopsContainer">
                                {# Stop 0 (Departure) #}
                                <div class="stop-row stop-item">
                                    <div class="stop-item__num" data-stop-badge>1</div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-extrabold small" data-stop-title>Étape 1 (Départ)</span>
                                        <span class="badge badge-lime small">Ville de départ</span>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small">Ville</label>
                                            <select name="stops[0][city_id]"
                                                    class="form-select form-select-sm"
                                                    required
                                                    data-action="change->trip-builder#onCityChange">
                                                {% for c in cities %}
                                                    <option value="{{ c.id }}">{{ c.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Heure de départ</label>
                                            <input type="datetime-local"
                                                   name="stops[0][departure_time]"
                                                   class="form-control form-control-sm"
                                                   required
                                                   data-action="input->trip-builder#onFieldInput">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Prix depuis étape précédente (MAD)</label>
                                            <input type="number"
                                                   step="0.01"
                                                   name="stops[0][price_from_previous]"
                                                   class="form-control form-control-sm"
                                                   value="0.00"
                                                   readonly>
                                        </div>
                                    </div>
                                </div>

                                {# Stop 1 (Second stop / Arrival) #}
                                <div class="stop-row stop-item">
                                    <div class="stop-item__num" data-stop-badge>2</div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-extrabold small" data-stop-title>Étape 2</span>
                                        <span class="badge badge-surface small">Arrêt ou terminus</span>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small">Ville</label>
                                            <select name="stops[1][city_id]"
                                                    class="form-select form-select-sm"
                                                    required
                                                    data-action="change->trip-builder#onCityChange">
                                                {% for c in cities %}
                                                    <option value="{{ c.id }}" {{ loop.index == 2 ? 'selected' : '' }}>{{ c.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">Heure d'arrivée</label>
                                            <input type="datetime-local"
                                                   name="stops[1][arrival_time]"
                                                   class="form-control form-control-sm"
                                                   required
                                                   data-action="input->trip-builder#onFieldInput">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">Heure de départ (si intermédiaire)</label>
                                            <input type="datetime-local"
                                                   name="stops[1][departure_time]"
                                                   class="form-control form-control-sm"
                                                   data-action="input->trip-builder#onFieldInput">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">Prix du segment (MAD)</label>
                                            <div class="price-input-wrap" data-price-wrap>
                                                <input type="number"
                                                       step="0.01"
                                                       min="0.01"
                                                       name="stops[1][price_from_previous]"
                                                       class="form-control form-control-sm"
                                                       value="100.00"
                                                       required
                                                       data-action="input->trip-builder#onFieldInput">
                                            </div>
                                            <div class="osrm-hint" data-osrm-hint>Tarif suggéré OSRM</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-lime w-100 py-3">
                                <i class="bi bi-send-check-fill me-1" aria-hidden="true"></i>Publier le trajet
                            </button>
                        </div>
                    </div>
                </div>

                {# Right Column: Sticky Live Summary #}
                <div class="col-lg-4">
                    <div class="card sticky-top glow-border" style="top: 5.5rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="h5 fw-extrabold mb-0">Aperçu en direct</h2>
                                <span class="badge badge-lime" data-trip-builder-target="summaryStopsCount">2 étapes</span>
                            </div>

                            <div class="p-3 rounded-3 border mb-3" style="background-color: var(--surface-2);">
                                <div class="small text-muted text-uppercase fw-bold mb-1">Véhicule choisi</div>
                                <div class="small fw-semibold" data-trip-builder-target="summaryVehicle">
                                    {{ vehicles|first.brand }} {{ vehicles|first.model }} ({{ vehicles|first.color }}) &bull; {{ min(3, vehicles|first.seats) }}/{{ vehicles|first.seats }} pl.
                                </div>
                            </div>

                            <div class="alert alert-warning small py-2 px-3 mb-3 d-none" role="status" data-trip-builder-target="degradedBanner">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                <strong>Estimation (repli Haversine) :</strong> le calcul routier OSRM est indisponible, les distances et tarifs suggérés sont estimés à vol d'oiseau.
                            </div>

                            <div class="small text-muted text-uppercase fw-bold mb-2">Chaîne des étapes</div>
                            <div class="trip-summary__chain p-3 rounded-3 border mb-3"
                                 style="background-color: var(--surface-2);"
                                 data-trip-builder-target="summaryChain">
                            </div>

                            <div class="small text-muted text-uppercase fw-bold mb-2">Total par segment</div>
                            <div class="p-3 rounded-3 border mb-3 vstack gap-1 small"
                                 style="background-color: var(--surface-2);"
                                 data-trip-builder-target="summarySegments">
                            </div>

                            <div class="p-3 rounded-3 border mb-3" style="background-color: var(--surface-2);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted">Distance &amp; durée totales</span>
                                    <span class="small fw-semibold" data-trip-builder-target="summaryDistance">—</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted">Tarif trajet complet / passager</span>
                                    <span class="summary-value" data-trip-builder-target="summaryPrice">100.00 MAD</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="small fw-bold">Revenu max potentiel</span>
                                    <span class="fs-5 fw-extrabold text-highlight-lime" data-trip-builder-target="summaryRevenue">300.00 MAD</span>
                                </div>
                            </div>

                            <div class="small text-muted">
                                <i class="bi bi-shield-check me-1" style="color: var(--accent);" aria-hidden="true"></i>
                                Chaque segment intermédiaire pourra être réservé et revendu indépendamment sans surréservation.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
{% endif %}
{% endblock %}
