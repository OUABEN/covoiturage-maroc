<!DOCTYPE html>
<html lang="fr" data-theme="dark" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}AtlasCovoit Maroc — Covoiturage Régional par Segments{% endblock %}</title>
        <script>
            (function () {
                try {
                    var stored = localStorage.getItem('theme');
                    var preferred = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
                    var theme = (stored === 'light' || stored === 'dark') ? stored : preferred;
                    document.documentElement.setAttribute('data-theme', theme);
                    document.documentElement.setAttribute('data-bs-theme', theme);
                    if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                        document.documentElement.classList.add('js-motion');
                    }
                } catch (_) {}
            })();
        </script>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%23C6F432%22/><text x=%2264%22 y=%2290%22 text-anchor=%22middle%22 font-family=%22sans-serif%22 font-weight=%22900%22 font-size=%2276%22 fill=%22%230B0B0C%22>A</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
        <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
        <link href="{{ asset('styles/motion.css') }}" rel="stylesheet">
        <link href="{{ asset('styles/pages.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body data-turbo="false">
        {% set currentRoute = app.request.attributes.get('_route') %}
        <div class="aurora" aria-hidden="true">
            <div class="aurora__grid"></div>
            <div class="aurora__blob aurora__blob--1"></div>
            <div class="aurora__blob aurora__blob--2"></div>
            <div class="aurora__blob aurora__blob--3"></div>
        </div>
        <div class="scroll-progress" aria-hidden="true"></div>
        <nav class="navbar navbar-expand-lg navbar-glass sticky-top" aria-label="Navigation principale">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <span class="brand-mark" aria-hidden="true">
                        <i class="bi bi-signpost-split-fill"></i>
                    </span>
                    <span>Atlas<span class="badge-lime ms-1 px-2 py-0 rounded-2">Covoit</span></span>
                </a>

                <div class="d-flex align-items-center gap-2 order-lg-last ms-auto ms-lg-2">
                    <button type="button"
                            class="btn-theme-toggle"
                            data-controller="theme"
                            data-action="click->theme#toggle"
                            aria-label="Basculer entre le mode clair et le mode sombre"
                            aria-pressed="true">
                        <i class="bi bi-sun-fill" data-theme-target="icon" aria-hidden="true"></i>
                        <span class="d-none d-sm-inline" data-theme-target="label">Clair</span>
                    </button>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Ouvrir le menu de navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link {{ currentRoute in ['app_home', 'app_search'] ? 'active' : '' }}" href="{{ path('app_home') }}">
                                <i class="bi bi-search me-1" aria-hidden="true"></i>Rechercher
                            </a>
                        </li>
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link {{ currentRoute == 'app_trip_new' ? 'active' : '' }}" href="{{ path('app_trip_new') }}">
                                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Publier un trajet
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ currentRoute == 'app_my_bookings' ? 'active' : '' }}" href="{{ path('app_my_bookings') }}">
                                    <i class="bi bi-ticket-perforated me-1" aria-hidden="true"></i>Mes réservations
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ currentRoute in ['app_my_trips', 'app_my_vehicles'] ? 'active' : '' }}" href="{{ path('app_my_trips') }}">
                                    <i class="bi bi-car-front me-1" aria-hidden="true"></i>Espace conducteur
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-outline-light" href="{{ path('admin') }}">
                                        <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Administration
                                    </a>
                                </li>
                            {% endif %}
                            <li class="nav-item">
                                <a class="nav-link d-inline-flex align-items-center gap-2 fw-semibold {{ currentRoute == 'app_profile_show' ? 'active' : '' }}" href="{{ path('app_profile_show', {id: app.user.id}) }}">
                                    <span class="avatar-initials" style="width: 30px; height: 30px; font-size: 0.75rem; border-radius: 8px;">
                                        {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                                    </span>
                                    <span>{{ app.user.fullName }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">
                                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Connexion
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-lime" href="{{ path('app_register') }}">
                                    <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Inscription
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        {% block hero %}{% endblock %}

        <main class="py-4">
            <div class="container">
                {% include 'components/flash.html.twig' %}
                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="border-top pt-4 pb-4 mt-auto" style="background-color: var(--surface);">
            {% set marqueeCities = ['Agadir', 'Marrakech', 'Essaouira', 'Casablanca', 'Rabat', 'Fès', 'Tiznit', 'Taroudant', 'Safi', 'El Jadida'] %}
            <div class="city-marquee mb-4" aria-hidden="true">
                <div class="city-marquee__track">
                    {% for i in 1..2 %}
                        {% for city in marqueeCities %}
                            <span class="city-marquee__item">{{ city }}</span>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
            <div class="container">
                <div class="row gy-3 align-items-center justify-content-between">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 fw-bold mb-1">
                            <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: var(--accent);"></span>
                            <span>AtlasCovoit Maroc</span>
                        </div>
                        <p class="text-muted small mb-0">
                            Plateforme de covoiturage régional multi-étapes au Maroc &bull; Réservation par portion au juste prix.
                        </p>
                    </div>
                    <div class="col-md-6 text-md-end text-muted small">
                        <div>PFE Challenge EMC &mdash; Sujet 3 (Symfony 7.4 &bull; MySQL 8 &bull; Docker)</div>
                        <div class="mt-1">Agadir &bull; Marrakech &bull; Essaouira &bull; Casablanca &bull; Rabat &bull; Fès</div>
                    </div>
                </div>
            </div>
        </footer>

        <button type="button" class="back-to-top" aria-label="Revenir en haut de la page">
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="16" pathLength="100"></circle></svg>
            <i class="bi bi-arrow-up" aria-hidden="true"></i>
        </button>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
