{% extends 'base.html.twig' %}

{% block title %}Mes réservations — AtlasCovoit Maroc{% endblock %}

{% block body %}
{# Page Hero Header #}
<div class="page-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="eyebrow">Espace Passager</div>
            <h1 class="fw-extrabold mb-2">
                Mes <span class="text-highlight-lime">réservations</span> par segment
            </h1>
            <p class="text-muted mb-0" style="max-width: 620px;">
                Suivez vos billets confirmés, visualisez en temps réel votre palier de remboursement garanti et évaluez vos conducteurs après chaque trajet terminé.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_home') }}" class="btn btn-lime">
                <i class="bi bi-search me-1" aria-hidden="true"></i>Rechercher un trajet
            </a>
            <a href="{{ path('app_trip_new') }}" class="btn btn-outline-light">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Publier un trajet
            </a>
        </div>
    </div>

    {# KPI Row #}
    <div class="row g-3 mt-3">
        <div class="col-sm-4">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Trajets à venir</span>
                    <span class="icon-chip"><i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value" data-controller="counter" data-counter-target-value="{{ upcomingBookings|length }}">
                    {{ upcomingBookings|length }}
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Trajets effectués</span>
                    <span class="icon-chip icon-chip--ghost"><i class="bi bi-check2-all" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value" data-controller="counter" data-counter-target-value="{{ pastBookings|length }}">
                    {{ pastBookings|length }}
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="kpi-card__label">Annulations &amp; remboursements</span>
                    <span class="icon-chip icon-chip--ghost"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></span>
                </div>
                <div class="kpi-card__value" data-controller="counter" data-counter-target-value="{{ cancelledBookings|length }}">
                    {{ cancelledBookings|length }}
                </div>
                <div class="kpi-card__bar"></div>
            </div>
        </div>
    </div>
</div>

{# Segmented Tabs Controller #}
<div data-controller="tabs">
    <div class="seg-tabs" role="tablist" aria-label="Filtrer mes réservations" data-action="keydown->tabs#keydown">
        <span class="seg-tabs__indicator" data-tabs-target="indicator" aria-hidden="true"></span>

        <button type="button"
                class="seg-tab"
                role="tab"
                aria-selected="true"
                tabindex="0"
                data-tabs-target="tab"
                data-action="click->tabs#select">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>
            <span>À venir</span>
            <span class="count-pill">{{ upcomingBookings|length }}</span>
        </button>

        <button type="button"
                class="seg-tab"
                role="tab"
                aria-selected="false"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select">
            <i class="bi bi-check2-circle" aria-hidden="true"></i>
            <span>Passées &amp; Avis</span>
            <span class="count-pill">{{ pastBookings|length }}</span>
        </button>

        <button type="button"
                class="seg-tab"
                role="tab"
                aria-selected="false"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select">
            <i class="bi bi-x-octagon" aria-hidden="true"></i>
            <span>Annulées</span>
            <span class="count-pill">{{ cancelledBookings|length }}</span>
        </button>
    </div>

    {# PANEL 1: UPCOMING BOOKINGS #}
    <section class="seg-panel is-entering" role="tabpanel" data-tabs-target="panel">
        <h2 class="section-title">
            <i class="bi bi-calendar-check" style="color: var(--accent);" aria-hidden="true"></i>
            <span>Réservations à venir</span>
            <span class="count-pill">{{ upcomingBookings|length }}</span>
        </h2>

        {% if upcomingBookings is empty %}
            <div class="card mb-4">
                <div class="empty-state">
                    <div class="empty-state__art" aria-hidden="true">
                        <i class="bi bi-compass"></i>
                    </div>
                    <h3 class="h5 fw-extrabold mb-1">Aucune réservation à venir</h3>
                    <p class="text-muted small mb-3">
                        Explorez les trajets multi-étapes publiés et réservez uniquement le segment qui vous intéresse.
                    </p>
                    <a href="{{ path('app_home') }}" class="btn btn-lime btn-sm">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Trouver un trajet
                    </a>
                </div>
            </div>
        {% else %}
            <div class="vstack gap-3 mb-5">
                {% for booking in upcomingBookings %}
                    {% set preview = refundPreviews[booking.id] ?? {'percentage': 0, 'amount': '0.00'} %}
                    <div class="card ticket hover-lift">
                        <div class="ticket__main">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge badge-lime">
                                        <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Confirmée
                                    </span>
                                    <span class="badge badge-surface">Billet #{{ booking.id }}</span>
                                </div>
                                <a href="{{ path('app_trip_show', {id: booking.trip.id}) }}" class="small fw-bold text-decoration-none">
                                    Voir l'itinéraire complet <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                </a>
                            </div>

                            {# Animated Route Track #}
                            <div class="ticket-route">
                                <div>
                                    <div class="ticket-route__city">{{ booking.fromStop.city.name }}</div>
                                    <div class="ticket-route__time">
                                        <i class="bi bi-play-circle me-1" aria-hidden="true"></i>
                                        {{ booking.fromStop.departureTime|date('d/m/Y à H:i') }}
                                    </div>
                                </div>

                                <div class="ticket-route__track" aria-hidden="true">
                                    <span class="ticket-route__car">
                                        <i class="bi bi-car-front-fill"></i>
                                    </span>
                                </div>

                                <div class="text-end">
                                    <div class="ticket-route__city">{{ booking.toStop.city.name }}</div>
                                    <div class="ticket-route__time">
                                        <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>
                                        Arrivée {{ (booking.toStop.arrivalTime ?? booking.toStop.departureTime)|date('H:i') }}
                                    </div>
                                </div>
                            </div>

                            <div class="ticket-meta">
                                <span>
                                    <i class="bi bi-person-badge me-1" aria-hidden="true"></i>Conducteur :
                                    <a href="{{ path('app_profile_show', {id: booking.trip.driver.id}) }}" class="fw-bold text-decoration-none">
                                        {{ booking.trip.driver.fullName }}
                                    </a>
                                </span>
                                <span>
                                    <i class="bi bi-car-front me-1" aria-hidden="true"></i>
                                    <strong>{{ booking.trip.vehicle.brand }} {{ booking.trip.vehicle.model }}</strong>
                                </span>
                                <span>
                                    <i class="bi bi-people me-1" aria-hidden="true"></i>
                                    <strong>{{ booking.seats }} place(s) réservée(s)</strong>
                                </span>
                            </div>
                        </div>

                        {# Perforated Ticket Stub #}
                        <div class="ticket__stub">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="small text-muted fw-semibold">Montant figé</span>
                                <span class="fs-4 fw-extrabold text-highlight-lime">{{ booking.price }} MAD</span>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Remboursement si annulation</span>
                                    <strong class="text-white">{{ preview.percentage }} % ({{ preview.amount }} MAD)</strong>
                                </div>
                                <div class="refund-meter" title="Palier de remboursement actuel : {{ preview.percentage }} %">
                                    <div class="refund-meter__fill" style="--p: {{ preview.percentage }}%;"></div>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-1">
                                <a href="{{ path('app_booking_cancel_confirm', {id: booking.id}) }}" class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-calculator me-1" aria-hidden="true"></i>Aperçu annulation ({{ preview.percentage }} %)
                                </a>
                                <form method="post"
                                      action="{{ path('app_booking_cancel', {id: booking.id}) }}"
                                      data-confirm="Confirmer l'annulation de la réservation #{{ booking.id }} ({{ booking.fromStop.city.name }} → {{ booking.toStop.city.name }}) ? Remboursement prévu : {{ preview.percentage }} % ({{ preview.amount }} MAD)."
                                      data-confirm-label="Confirmer l'annulation">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_booking_' ~ booking.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Annuler (remboursement {{ preview.percentage }} % : {{ preview.amount }} MAD)
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# PANEL 2: PAST BOOKINGS & REVIEWS #}
    <section class="seg-panel" role="tabpanel" data-tabs-target="panel">
        <h2 class="section-title">
            <i class="bi bi-check2-circle" style="color: var(--accent);" aria-hidden="true"></i>
            <span>Réservations passées &amp; Avis</span>
            <span class="count-pill">{{ pastBookings|length }}</span>
        </h2>

        {% if pastBookings is empty %}
            <div class="card mb-4">
                <div class="empty-state">
                    <div class="empty-state__art" aria-hidden="true">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <h3 class="h5 fw-extrabold mb-1">Aucune réservation passée</h3>
                    <p class="text-muted small mb-0">
                        Vos trajets terminés apparaîtront ici pour vous permettre de laisser un avis vérifié au conducteur.
                    </p>
                </div>
            </div>
        {% else %}
            <div class="vstack gap-3 mb-5">
                {% for booking in pastBookings %}
                    {% set isCompletedAndConfirmed = booking.status.value == 'CONFIRMED' and booking.trip.status.value == 'COMPLETED' %}
                    {% set alreadyReviewed = reviewedBookingIds[booking.id] ?? false %}
                    <div class="card hover-lift">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-4">
                                <div class="col-lg-6">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge badge-surface">
                                            <i class="bi bi-flag-fill me-1" aria-hidden="true"></i>Trajet terminé
                                        </span>
                                        <span class="badge badge-lime">{{ booking.price }} MAD</span>
                                    </div>
                                    <div class="fw-extrabold fs-5">
                                        {{ booking.fromStop.city.name }} &rarr; {{ booking.toStop.city.name }}
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Conducteur :
                                        <a href="{{ path('app_profile_show', {id: booking.trip.driver.id}) }}" class="fw-bold text-decoration-none">
                                            {{ booking.trip.driver.fullName }}
                                        </a>
                                        &bull; {{ booking.seats }} place(s)
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    {% if isCompletedAndConfirmed and not alreadyReviewed %}
                                        <form method="post" action="{{ path('app_booking_review', {id: booking.id}) }}" class="review-box">
                                            <input type="hidden" name="_token" value="{{ csrf_token('review_booking_' ~ booking.id) }}">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-extrabold small">
                                                    <i class="bi bi-star-fill me-1" style="color: var(--accent);" aria-hidden="true"></i>
                                                    Noter {{ booking.trip.driver.fullName }}
                                                </span>
                                                <span class="badge badge-lime small">Avis vérifié</span>
                                            </div>
                                            <div class="row g-2 align-items-center">
                                                <div class="col-sm-3">
                                                    <select name="rating" class="form-select form-select-sm" aria-label="Note sur 5" required>
                                                        <option value="5">5 / 5 ★</option>
                                                        <option value="4">4 / 5 ★</option>
                                                        <option value="3">3 / 5 ★</option>
                                                        <option value="2">2 / 5 ★</option>
                                                        <option value="1">1 / 5 ★</option>
                                                    </select>
                                                </div>
                                                <div class="col-sm-6">
                                                    <input type="text" name="comment" class="form-control form-control-sm" placeholder="Votre commentaire sur le trajet…">
                                                </div>
                                                <div class="col-sm-3 d-grid">
                                                    <button type="submit" class="btn btn-lime btn-sm">Envoyer l'avis</button>
                                                </div>
                                            </div>
                                        </form>
                                    {% elseif isCompletedAndConfirmed and alreadyReviewed %}
                                        <div class="text-lg-end">
                                            <span class="badge badge-lime">
                                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Avis déjà publié pour ce trajet
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# PANEL 3: CANCELLED BOOKINGS #}
    <section class="seg-panel" role="tabpanel" data-tabs-target="panel">
        <h2 class="section-title">
            <i class="bi bi-x-octagon text-muted" aria-hidden="true"></i>
            <span>Réservations annulées</span>
            <span class="count-pill">{{ cancelledBookings|length }}</span>
        </h2>

        {% if cancelledBookings is empty %}
            <div class="card">
                <div class="empty-state">
                    <div class="empty-state__art" aria-hidden="true">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3 class="h5 fw-extrabold mb-1">Aucune réservation annulée</h3>
                    <p class="text-muted small mb-0">
                        Toutes vos réservations ont été maintenues.
                    </p>
                </div>
            </div>
        {% else %}
            <div class="vstack gap-3">
                {% for booking in cancelledBookings %}
                    <div class="card ticket ticket--muted">
                        <div class="ticket__main">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                {% if booking.status.value == 'CANCELLED_BY_PASSENGER' %}
                                    <span class="badge badge-surface">Annulée par vous</span>
                                {% else %}
                                    <span class="badge badge-danger-soft">Annulée par le conducteur (remboursée à 100 %)</span>
                                {% endif %}
                                <span class="small text-muted">Billet #{{ booking.id }}</span>
                            </div>
                            <div class="fw-extrabold fs-5">
                                {{ booking.fromStop.city.name }} &rarr; {{ booking.toStop.city.name }}
                            </div>
                            <div class="small text-muted mt-1">
                                Prix initial : {{ booking.price }} MAD &bull; Remboursé : <strong class="text-white">{{ booking.refundAmount ?? '0.00' }} MAD</strong>
                            </div>
                        </div>
                        <div class="ticket__stub">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">Remboursement crédité</span>
                                <span class="badge badge-lime fs-6">{{ booking.refundAmount ?? '0.00' }} MAD</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
