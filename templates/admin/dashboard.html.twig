{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}AtlasCovoit Maroc — Back-office d'administration{% endblock %}

{% block main %}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ea-kpi-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold opacity-75">Villes référencées</span>
                <span class="ea-kpi-badge"><i class="fa fa-city"></i></span>
            </div>
            <div class="fs-2 fw-bold">{{ citiesCount }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ea-kpi-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold opacity-75">Utilisateurs inscrits</span>
                <span class="ea-kpi-badge"><i class="fa fa-users"></i></span>
            </div>
            <div class="fs-2 fw-bold">{{ usersCount }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ea-kpi-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold opacity-75">Véhicules enregistrés</span>
                <span class="ea-kpi-badge"><i class="fa fa-car"></i></span>
            </div>
            <div class="fs-2 fw-bold">{{ vehiclesCount }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ea-kpi-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold opacity-75">Trajets multi-étapes</span>
                <span class="ea-kpi-badge"><i class="fa fa-route"></i></span>
            </div>
            <div class="fs-2 fw-bold">{{ tripsCount }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ea-kpi-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold opacity-75">Réservations (lecture seule)</span>
                <span class="ea-kpi-badge"><i class="fa fa-ticket"></i></span>
            </div>
            <div class="fs-2 fw-bold">{{ bookingsCount }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ea-kpi-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold opacity-75">Avis publiés</span>
                <span class="ea-kpi-badge"><i class="fa fa-star"></i></span>
            </div>
            <div class="fs-2 fw-bold">{{ reviewsCount }}</div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    <strong>Règle d'intégrité métier :</strong> La création et la modification directe d'entités <code>Booking</code> depuis le back-office sont désactivées (mode lecture seule). Toute réservation doit obligatoirement passer par <code>BookingService::book()</code> afin de garantir le verrouillage pessimiste (<code>SELECT ... FOR UPDATE</code>) et le respect de la capacité par segment.
</div>
{% endblock %}
