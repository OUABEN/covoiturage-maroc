{% extends 'base.html.twig' %}

{% block title %}Connexion — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="row justify-content-center py-3">
    <div class="col-xl-10">
        <div class="auth-split-card">
            <div class="row g-0">
                {# Left Dark Visual Panel #}
                <div class="col-lg-5 auth-visual-panel">
                    <div>
                        <span class="badge badge-lime mb-3">
                            <i class="bi bi-shield-lock-fill me-1" aria-hidden="true"></i>Accès sécurisé
                        </span>
                        <h2 class="h3 fw-extrabold mb-3">
                            Reprenez la route avec <span class="text-highlight-lime">AtlasCovoit</span>
                        </h2>
                        <p class="small mb-4" style="color: #A1A1AA;">
                            Un compte unique vous permet de réserver vos places par segment ou de publier vos propres trajets multi-étapes à travers le Maroc.
                        </p>

                        <div class="mb-4">
                            {% include 'components/city_image.html.twig' with {
                                cityName: 'Agadir',
                                height: 155,
                                class: 'w-100 object-fit-cover d-block'
                            } %}
                        </div>

                        <div class="d-grid gap-3 small">
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge badge-lime rounded-circle p-1 mt-1" aria-hidden="true">
                                    <i class="bi bi-check2"></i>
                                </span>
                                <div>
                                    <strong class="d-block text-white">Réservation garantie sans surréservation</strong>
                                    <span style="color: #A1A1AA;">Verrouillage transactionnel segment par segment.</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge badge-lime rounded-circle p-1 mt-1" aria-hidden="true">
                                    <i class="bi bi-check2"></i>
                                </span>
                                <div>
                                    <strong class="d-block text-white">Remboursement transparent</strong>
                                    <span style="color: #A1A1AA;">Jusqu'à 100 % calculé automatiquement avant confirmation.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 mt-4 border-top" style="border-color: #2A2A2E !important;">
                        <div class="small" style="color: #A1A1AA;">
                            <i class="bi bi-geo-alt-fill me-1" style="color: var(--accent);" aria-hidden="true"></i>
                            Réseau Souss-Massa · Marrakech-Safi · Casablanca-Settat · Fès-Meknès
                        </div>
                    </div>
                </div>

                {# Right Form Panel #}
                <div class="col-lg-7 auth-form-panel d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <h1 class="h3 fw-extrabold mb-1">Connexion</h1>
                        <p class="text-muted small mb-0">
                            Entrez vos identifiants pour accéder à votre espace passager et conducteur.
                        </p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5" aria-hidden="true"></i>
                            <div>
                                <strong>Échec de connexion :</strong> Identifiants invalides. Veuillez vérifier votre adresse e-mail et votre mot de passe.
                            </div>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="username" class="form-label">
                                <i class="bi bi-envelope-fill me-1" aria-hidden="true"></i>Adresse e-mail
                            </label>
                            <input
                                type="email"
                                value="{{ last_username }}"
                                name="_username"
                                id="username"
                                class="form-control {{ error ? 'is-invalid' : '' }}"
                                autocomplete="email"
                                placeholder="youssef.benali@covoiturage.ma"
                                required
                                autofocus
                            >
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <i class="bi bi-key-fill me-1" aria-hidden="true"></i>Mot de passe
                            </label>
                            <input
                                type="password"
                                name="_password"
                                id="password"
                                class="form-control {{ error ? 'is-invalid' : '' }}"
                                autocomplete="current-password"
                                placeholder="••••••••"
                                required
                            >
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                                <label class="form-check-label small" for="remember_me">
                                    Se souvenir de moi pendant 7 jours
                                </label>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-lime w-100 py-3" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Se connecter
                        </button>
                    </form>

                    <hr class="my-4">
                    <p class="text-center small mb-0">
                        Pas encore de compte sur AtlasCovoit ?
                        <a href="{{ path('app_register') }}" class="fw-extrabold text-decoration-underline ms-1">Créer un compte</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
