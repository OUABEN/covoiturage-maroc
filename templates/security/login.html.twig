{% extends 'base.html.twig' %}

{% block title %}Connexion — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 fw-bold mb-2 text-center">Connexion</h1>
                <p class="text-muted text-center small mb-4">
                    Accédez à votre espace passager et conducteur sur AtlasCovoit Maroc.
                </p>

                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Identifiants invalides. Veuillez vérifier votre e-mail et votre mot de passe.
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Adresse e-mail</label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            class="form-control"
                            autocomplete="email"
                            placeholder="youssef.benali@covoiturage.ma"
                            required
                            autofocus
                        >
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">Mot de passe</label>
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            class="form-control"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                        <label class="form-check-label small" for="remember_me">
                            Se souvenir de moi
                        </label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-brand w-100 py-2 fw-semibold" type="submit">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Se connecter
                    </button>
                </form>

                <hr class="my-4">
                <p class="text-center small mb-0">
                    Pas encore de compte ?
                    <a href="{{ path('app_register') }}" class="fw-semibold text-decoration-none">Créer un compte</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
