{% extends 'base.html.twig' %}

{% block title %}Rechercher un trajet — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="p-4 p-md-5 mb-4 rounded-3 bg-brand text-white shadow-sm">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge bg-warning text-dark fw-semibold mb-2">Covoiturage Régional Maroc</span>
            <h1 class="display-6 fw-bold mb-2">Voyagez d'une ville à l'autre, étape par étape</h1>
            <p class="lead mb-0 opacity-90">
                Réservez uniquement la portion de trajet dont vous avez besoin (ex. Agadir &rarr; Marrakech ou Marrakech &rarr; Casablanca) au prix exact du segment.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow mt-4 text-dark">
        <div class="card-body p-3 p-md-4">
            <form method="get" action="{{ path('app_home') }}" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="from" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-geo-alt-fill text-success me-1"></i>Ville de départ
                    </label>
                    <select name="from" id="from" class="form-select" required>
                        <option value="">Choisir une ville de départ...</option>
                        {% for city in cities %}
                            <option value="{{ city.id }}" {{ selectedFrom and selectedFrom.id == city.id ? 'selected' : '' }}>
                                {{ city.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="to" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-pin-map-fill text-danger me-1"></i>Ville d'arrivée
                    </label>
                    <select name="to" id="to" class="form-select" required>
                        <option value="">Choisir une ville d'arrivée...</option>
                        {% for city in cities %}
                            <option value="{{ city.id }}" {{ selectedTo and selectedTo.id == city.id ? 'selected' : '' }}>
                                {{ city.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="date" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-calendar-event me-1"></i>Date
                    </label>
                    <input type="date" name="date" id="date" class="form-control" value="{{ selectedDate }}" required>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-brand py-2 fw-semibold">
                        <i class="bi bi-search me-1"></i>Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% if isSearched %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-bold mb-0">
            Trajets de {{ selectedFrom.name }} à {{ selectedTo.name }}
            <span class="text-muted fw-normal fs-6">({{ results|length }} résultat{{ results|length > 1 ? 's' : '' }})</span>
        </h2>
    </div>

    {% if results is empty %}
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <i class="bi bi-compass fs-1 text-muted"></i>
                <h3 class="h5 fw-bold mt-3">Aucun trajet disponible pour cette recherche</h3>
                <p class="text-muted mb-0">
                    Essayez une autre date ou vérifiez les villes de départ et d'arrivée.
                </p>
            </div>
        </div>
    {% else %}
        <div class="row g-3">
            {% for item in results %}
                {% set trip = item.trip %}
                {% set driver = trip.driver %}
                {% set ratingInfo = driverRatings[driver.id] ?? {'average': null, 'count': 0} %}
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">
                                <div class="col-md-5">
                                    <div class="d-flex align-items-center gap-3">
                                        <div>
                                            <div class="fw-bold fs-5">
                                                {{ item.fromStop.departureTime|date('H:i') }}
                                                <span class="text-muted mx-1">&rarr;</span>
                                                {{ (item.toStop.arrivalTime ?? item.toStop.departureTime)|date('H:i') }}
                                            </div>
                                            <div class="fw-semibold text-dark">
                                                {{ item.fromStop.city.name }}
                                                <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                                {{ item.toStop.city.name }}
                                            </div>
                                            <div class="small text-muted mt-1">
                                                <i class="bi bi-signpost-2 me-1"></i>
                                                Itinéraire complet :
                                                {% for stop in trip.stops %}
                                                    {{ stop.city.name }}{% if not loop.last %} &rarr; {% endif %}
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="fw-semibold">
                                        <i class="bi bi-person-circle me-1 text-secondary"></i>
                                        <a href="{{ path('app_profile_show', {id: driver.id}) }}" class="text-decoration-none text-dark">
                                            {{ driver.fullName }}
                                        </a>
                                    </div>
                                    <div class="small text-muted">
                                        {% if ratingInfo.average is not null %}
                                            <span class="text-warning"><i class="bi bi-star-fill"></i></span>
                                            <strong>{{ ratingInfo.average }}/5</strong> ({{ ratingInfo.count }} avis)
                                        {% else %}
                                            <span>Nouveau conducteur</span>
                                        {% endif %}
                                        &bull; {{ trip.vehicle.brand }} {{ trip.vehicle.model }}
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-person-check me-1"></i>{{ item.availableSeats }} place(s) restante(s) sur cette portion
                                        </span>
                                    </div>
                                </div>

                                <div class="col-md-3 text-md-end">
                                    <div class="fs-4 fw-bold text-dark">{{ item.portionPrice }} MAD</div>
                                    <div class="small text-muted mb-2">par passager</div>
                                    <a href="{{ path('app_trip_show', {id: trip.id, from: item.fromStop.id, to: item.toStop.id}) }}" class="btn btn-brand fw-semibold">
                                        Voir &amp; Réserver <i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endif %}
{% endblock %}
