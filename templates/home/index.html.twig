{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="">
{% endblock %}

{% block javascripts %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""
            defer></script>
{% endblock %}

{% block title %}
    {% if isSearched %}
        Trajets {{ selectedFrom.name }} &rarr; {{ selectedTo.name }} — AtlasCovoit Maroc
    {% else %}
        AtlasCovoit Maroc — Covoiturage Régional par Segments
    {% endif %}
{% endblock %}

{% block hero %}
<section class="hero-section"
         data-controller="parallax-3d"
         data-action="pointermove->parallax-3d#move pointerleave->parallax-3d#leave">
    <div class="container">
        <div class="row align-items-center g-4 mb-4">
            <div class="col-lg-7">
                <div class="mb-3">
                    {% include 'components/badge.html.twig' with {
                        text: 'Covoiturage Régional Multi-Étapes au Maroc',
                        variant: 'lime',
                        icon: 'lightning-charge-fill'
                    } %}
                </div>
                <h1 class="display-5 fw-extrabold mb-3">
                    Voyagez d'une ville à l'autre, <span class="text-highlight-lime">étape par étape</span>.
                </h1>
                <p class="lead text-muted mb-4" style="max-width: 640px;">
                    Réservez uniquement la portion de trajet dont vous avez besoin — <strong>Agadir &rarr; Marrakech</strong> ou <strong>Marrakech &rarr; Casablanca</strong> — au prix exact du segment traversé.
                </p>

                {# Chiffres clés avec compteurs animés #}
                <div class="row g-3" style="max-width: 540px;">
                    <div class="col-4">
                        <div class="p-2 rounded-3 border text-center" style="background-color: var(--surface);">
                            <div class="fs-4 fw-extrabold"
                                 data-controller="counter"
                                 data-counter-target-value="10">10</div>
                            <div class="small text-muted">Villes du réseau</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 border text-center" style="background-color: var(--surface);">
                            <div class="fs-4 fw-extrabold"
                                 data-controller="counter"
                                 data-counter-target-value="100"
                                 data-counter-suffix-value=" %">100 %</div>
                            <div class="small text-muted">Places optimisées</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 border text-center" style="background-color: var(--surface);">
                            <div class="fs-4 fw-extrabold"
                                 data-controller="counter"
                                 data-counter-target-value="0.60"
                                 data-counter-decimals-value="2"
                                 data-counter-suffix-value=" MAD">0,60 MAD</div>
                            <div class="small text-muted">Tarif OSRM / km</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Composition 3D en CSS + Visuel Hero WebP #}
            <div class="col-lg-5">
                <div class="hero-3d-scene">
                    <div class="hero-3d-stage" data-parallax-3d-target="stage">
                        <div class="hero-3d-card-main">
                            <img src="/images/cities/agadir.webp"
                                 srcset="/images/cities/agadir-sm.webp 800w, /images/cities/agadir.webp 1600w"
                                 sizes="(max-width: 992px) 400px, 520px"
                                 width="1600"
                                 height="900"
                                 fetchpriority="high"
                                 decoding="async"
                                 alt="Photographie de la côte atlantique d'Agadir au Maroc à l'heure dorée"
                                 class="w-100 h-auto d-block"
                                 onerror="this.style.display='none';">
                        </div>

                        <div class="hero-floating-badge hero-floating-top d-none d-md-flex align-items-center gap-2"
                             data-parallax-3d-target="layer"
                             data-depth="24">
                            <span class="badge badge-lime">Segment</span>
                            <span class="small fw-bold">Agadir &rarr; Marrakech &bull; 120 MAD</span>
                        </div>

                        <div class="hero-floating-badge hero-floating-bottom d-none d-md-flex align-items-center gap-2"
                             data-parallax-3d-target="layer"
                             data-depth="-20">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span class="small fw-bold">Verrouillage anti-surréservation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% set citiesJson = [] %}
        {% for c in cities %}
            {% set citiesJson = citiesJson|merge([{
                id: c.id,
                name: c.name,
                lat: c.latitude ? (c.latitude + 0) : null,
                lng: c.longitude ? (c.longitude + 0) : null
            }]) %}
        {% endfor %}

        <div class="search-floating-card"
             data-controller="home-map"
             data-home-map-cities-value="{{ citiesJson|json_encode|e('html_attr') }}"
             data-home-map-api-url-value="{{ path('api_map_trips') }}">

            {# Onglets Formulaire | Carte #}
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <div class="nav nav-pills search-mode-tabs gap-2" role="tablist" aria-label="Mode de recherche">
                    <button class="btn btn-sm btn-lime active"
                            type="button"
                            role="tab"
                            id="tab-search-form"
                            aria-selected="true"
                            data-home-map-target="formTabBtn"
                            data-action="click->home-map#showFormTab">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Formulaire
                    </button>
                    <button class="btn btn-sm btn-outline-light"
                            type="button"
                            role="tab"
                            id="tab-search-map"
                            aria-selected="false"
                            data-home-map-target="mapTabBtn"
                            data-action="click->home-map#showMapTab">
                        <i class="bi bi-map-fill me-1" aria-hidden="true"></i>Carte
                    </button>
                </div>
                <div class="small text-muted d-none d-md-flex align-items-center gap-1">
                    <i class="bi bi-pin-map-fill text-lime" aria-hidden="true"></i>
                    <span>Réseau direct 10 villes</span>
                </div>
            </div>

            {# Onglet 1 : Formulaire classique #}
            <div data-home-map-target="formPane">
                <form method="get" action="{{ path('app_home') }}" class="row g-3 align-items-end" aria-label="Rechercher un trajet">
                    <div class="col-md-4">
                        <label for="from" class="form-label mb-1">
                            <i class="bi bi-record-circle me-1" aria-hidden="true"></i>Ville de départ
                        </label>
                        <select name="from" id="from" class="form-select" required>
                            <option value="">Choisir une ville de départ...</option>
                            {% for city in cities %}
                                <option value="{{ city.id }}" {{ selectedFrom and selectedFrom.id == city.id ? 'selected' : '' }}>
                                    {{ city.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="to" class="form-label mb-1">
                            <i class="bi bi-geo-alt-fill me-1" aria-hidden="true"></i>Ville d'arrivée
                        </label>
                        <select name="to" id="to" class="form-select" required>
                            <option value="">Choisir une ville d'arrivée...</option>
                            {% for city in cities %}
                                <option value="{{ city.id }}" {{ selectedTo and selectedTo.id == city.id ? 'selected' : '' }}>
                                    {{ city.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label for="date" class="form-label mb-1">
                            <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Date de départ
                        </label>
                        <input type="date" name="date" id="date" class="form-control" value="{{ selectedDate }}" required>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-lime py-2">
                            <i class="bi bi-search me-1" aria-hidden="true"></i>Rechercher
                        </button>
                    </div>
                </form>
            </div>

            {# Onglet 2 : Recherche interactive par carte Leaflet + Panneau #}
            <div class="d-none" data-home-map-target="mapPane">
                <div class="row g-4 align-items-stretch">
                    {# Colonne gauche : Carte Leaflet #}
                    <div class="col-lg-7">
                        <div class="position-relative rounded-4 overflow-hidden border" style="border-color: var(--border) !important; background: var(--surface-2); min-height: 480px;">
                            <div data-home-map-target="canvas"
                                 style="height: 480px; width: 100%; z-index: 1;"></div>
                            <div class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill small fw-semibold shadow-sm"
                                 style="background: rgba(11, 11, 12, 0.88); color: #fff; border: 1px solid var(--border); z-index: 500; pointer-events: none;">
                                <span data-home-map-target="mapHint"><i class="bi bi-cursor-fill me-1 text-lime" aria-hidden="true"></i>Cliquez sur une ville de départ</span>
                            </div>
                        </div>

                        {# Alternative accessible au clavier #}
                        <div class="mt-2 p-2 rounded-3 border bg-surface small d-flex flex-wrap align-items-center gap-2">
                            <span class="text-muted"><i class="bi bi-keyboard me-1" aria-hidden="true"></i>Alternative clavier :</span>
                            <select class="form-select form-select-sm w-auto"
                                    data-home-map-target="keyboardFrom"
                                    data-action="change->home-map#onKeyboardFromChange"
                                    aria-label="Sélectionner la ville de départ au clavier">
                                <option value="">Départ...</option>
                                {% for city in cities %}
                                    <option value="{{ city.id }}">{{ city.name }}</option>
                                {% endfor %}
                            </select>
                            <span>&rarr;</span>
                            <select class="form-select form-select-sm w-auto"
                                    data-home-map-target="keyboardTo"
                                    data-action="change->home-map#onKeyboardToChange"
                                    aria-label="Sélectionner la ville d'arrivée au clavier">
                                <option value="">Arrivée...</option>
                                {% for city in cities %}
                                    <option value="{{ city.id }}">{{ city.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    {# Colonne droite : Panneau (sous la carte sur mobile) #}
                    <div class="col-lg-5 d-flex flex-column">
                        <div class="p-3 rounded-4 border h-100 d-flex flex-column" style="background: var(--surface-2); border-color: var(--border) !important;">
                            {# En-tête du panneau : Sélection départ/arrivée + Date + Actions #}
                            <div class="pb-3 border-bottom mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold text-uppercase text-muted">Itinéraire choisi</span>
                                    <span class="badge badge-surface small" data-home-map-target="resultsCount"></span>
                                </div>
                                <div class="fs-6 fw-bold mb-3 d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge px-2 py-1 text-muted border" data-home-map-target="fromBadge">Choisir départ</span>
                                    <i class="bi bi-arrow-right text-muted" aria-hidden="true"></i>
                                    <span class="badge px-2 py-1 text-muted border" data-home-map-target="toBadge">Choisir arrivée</span>
                                </div>

                                <div class="row g-2 align-items-center">
                                    <div class="col-12 col-sm-6">
                                        <label for="home-map-date" class="form-label small mb-1 text-muted">
                                            <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Date
                                        </label>
                                        <input type="date"
                                               id="home-map-date"
                                               class="form-control form-control-sm"
                                               value="{{ selectedDate }}"
                                               data-home-map-target="dateInput"
                                               data-action="change->home-map#onDateChange">
                                    </div>
                                    <div class="col-12 col-sm-6 d-flex gap-2 align-items-end pt-sm-3">
                                        <button type="button"
                                                class="btn btn-outline-light btn-sm flex-grow-1"
                                                data-action="click->home-map#swapCities"
                                                data-home-map-target="swapBtn"
                                                disabled
                                                title="Inverser départ et arrivée">
                                            <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>Échanger
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                data-action="click->home-map#resetSelection"
                                                data-home-map-target="resetBtn"
                                                title="Réinitialiser l'itinéraire">
                                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            {# Conteneur dynamique des résultats / états du panneau #}
                            <div class="flex-grow-1 overflow-auto" style="max-height: 380px;" data-home-map-target="resultsContainer">
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-map fs-1 mb-2 d-block text-lime" aria-hidden="true"></i>
                                    <div class="fw-bold mb-1">Sélectionnez votre itinéraire</div>
                                    <div class="small">Cliquez sur une ville sur la carte (1er clic = départ, 2ème clic = arrivée) ou utilisez l'alternative clavier.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block body %}
{% if isSearched %}
    <section aria-label="Résultats de recherche" class="animate-fade-up">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="h4 fw-bold mb-1">
                    Trajets de <span class="badge-lime px-2 py-0 rounded-2">{{ selectedFrom.name }}</span> à <span class="badge-lime px-2 py-0 rounded-2">{{ selectedTo.name }}</span>
                </h2>
                <div class="text-muted small">
                    {{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} disponible{{ results|length > 1 ? 's' : '' }} pour le {{ selectedDate|date('d/m/Y') }}
                </div>
            </div>

            {% if results|length > 1 %}
                <form method="get" action="{{ path('app_home') }}" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="from" value="{{ selectedFrom.id }}">
                    <input type="hidden" name="to" value="{{ selectedTo.id }}">
                    <input type="hidden" name="date" value="{{ selectedDate }}">
                    <label for="sort" class="small text-muted text-nowrap mb-0">Trier par :</label>
                    <select name="sort" id="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="departure_asc" {{ selectedSort == 'departure_asc' ? 'selected' : '' }}>Départ le plus tôt</option>
                        <option value="price_asc" {{ selectedSort == 'price_asc' ? 'selected' : '' }}>Prix croissant</option>
                        <option value="seats_desc" {{ selectedSort == 'seats_desc' ? 'selected' : '' }}>Places disponibles</option>
                    </select>
                </form>
            {% endif %}
        </div>

        {% if results is empty %}
            <div class="card p-5 text-center" data-controller="reveal">
                <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center rounded-circle"
                     style="width: 68px; height: 68px; background-color: var(--surface-2); border: 1px solid var(--border);">
                    <i class="bi bi-compass fs-2" aria-hidden="true"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">Aucun trajet disponible pour cette recherche</h3>
                <p class="text-muted mb-3 mx-auto" style="max-width: 460px;">
                    Aucun conducteur n'a encore publié de trajet couvrant la portion <strong>{{ selectedFrom.name }} &rarr; {{ selectedTo.name }}</strong> à cette date.
                </p>
                <div>
                    <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Réinitialiser la recherche
                    </a>
                </div>
            </div>
        {% else %}
            <div class="row g-3">
                {% for item in results %}
                    {% set trip = item.trip %}
                    {% set driver = trip.driver %}
                    {% set ratingInfo = driverRatings[driver.id] ?? {'average': null, 'count': 0} %}
                    <div class="col-12" data-controller="reveal" data-reveal-delay-value="{{ loop.index0 * 70 }}">
                        <div class="card card-interactive" data-controller="tilt">
                            <div class="card-body p-4">
                                <div class="row align-items-center g-4">
                                    {# Arrival city thumbnail #}
                                    <div class="col-md-3 col-lg-2">
                                        {% include 'components/city_image.html.twig' with {
                                            cityName: item.toStop.city.name,
                                            width: 400,
                                            height: 110
                                        } %}
                                    </div>

                                    {# Point-to-point visual route timeline with animated pulse dot #}
                                    <div class="col-md-9 col-lg-4">
                                        <div class="route-timeline mb-2">
                                            <div>
                                                <div class="fw-bold fs-4">{{ item.fromStop.departureTime|date('H:i') }}</div>
                                                <div class="fw-semibold small">{{ item.fromStop.city.name }}</div>
                                            </div>
                                            <div class="route-connector" aria-hidden="true">
                                                <span class="route-dot"></span>
                                                <span class="route-line">
                                                    <span class="route-pulse-dot"></span>
                                                </span>
                                                <i class="bi bi-car-front-fill small"></i>
                                                <span class="route-line">
                                                    <span class="route-pulse-dot"></span>
                                                </span>
                                                <span class="route-dot route-dot-end"></span>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold fs-4">{{ (item.toStop.arrivalTime ?? item.toStop.departureTime)|date('H:i') }}</div>
                                                <div class="fw-semibold small">{{ item.toStop.city.name }}</div>
                                            </div>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi bi-signpost-2 me-1" aria-hidden="true"></i>Itinéraire complet :
                                            {% for stop in trip.stops %}
                                                <span class="{{ stop.id in [item.fromStop.id, item.toStop.id] ? 'fw-bold' : '' }}">{{ stop.city.name }}</span>{% if not loop.last %} &rarr; {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>

                                    {# Driver profile, vehicle illustration & seats badge #}
                                    <div class="col-lg-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="avatar-initials" aria-hidden="true">
                                                {{ driver.firstName|slice(0, 1)|upper }}{{ driver.lastName|slice(0, 1)|upper }}
                                            </span>
                                            <div>
                                                <a href="{{ path('app_profile_show', {id: driver.id}) }}" class="fw-bold text-decoration-none">
                                                    {{ driver.fullName }}
                                                </a>
                                                <div class="small mt-1">
                                                    {% include 'components/rating.html.twig' with {
                                                        average: ratingInfo.average,
                                                        count: ratingInfo.count
                                                    } %}
                                                </div>
                                                <div class="d-flex align-items-center gap-2 small text-muted mt-1">
                                                    {% include 'components/car_image.html.twig' with {
                                                        seats: trip.vehicle.seats,
                                                        label: trip.vehicle.brand ~ ' ' ~ trip.vehicle.model,
                                                        displayHeight: 28
                                                    } %}
                                                    <span>{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            {% if item.availableSeats <= 1 %}
                                                <span class="badge badge-danger-soft">
                                                    <i class="bi bi-fire me-1" aria-hidden="true"></i>Dernière ! {{ item.availableSeats }} place(s) restante(s)
                                                </span>
                                            {% else %}
                                                <span class="badge badge-surface">
                                                    <i class="bi bi-person-check me-1" aria-hidden="true"></i>{{ item.availableSeats }} place(s) restante(s) sur cette portion
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# Price & Action #}
                                    <div class="col-lg-3 text-lg-end">
                                        <div class="mb-1">
                                            <span class="badge badge-lime fs-5">{{ item.portionPrice }} MAD</span>
                                        </div>
                                        <div class="small text-muted mb-3">par passager sur cette portion</div>
                                        <a href="{{ path('app_trip_show', {id: trip.id, from: item.fromStop.id, to: item.toStop.id}) }}" class="btn btn-lime w-100 w-lg-auto">
                                            Voir &amp; Réserver <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% else %}
    {# Section 1 : Comment ça marche (3 étapes) #}
    <section class="py-4 mb-5" aria-labelledby="how-it-works-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4" data-controller="reveal">
            <div>
                <span class="badge badge-lime mb-2">Fonctionnement</span>
                <h2 id="how-it-works-heading" class="h3 fw-bold mb-0">Comment ça marche ?</h2>
            </div>
            <p class="text-muted small mb-0">Un modèle pensé pour les grands axes régionaux marocains</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4" data-controller="reveal" data-reveal-delay-value="0">
                <div class="card h-100 card-interactive" data-controller="tilt">
                    <div class="card-body p-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3 badge-lime"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-signpost-split fs-4" aria-hidden="true"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-2">1. Choisissez votre portion</h3>
                        <p class="text-muted small mb-0">
                            Sélectionnez votre ville de montée et de descente parmi les arrêts intermédiaires du trajet (ex. Agadir &rarr; Marrakech sur un trajet Agadir &rarr; Casablanca).
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4" data-controller="reveal" data-reveal-delay-value="100">
                <div class="card h-100 card-interactive" data-controller="tilt">
                    <div class="card-body p-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3 badge-lime"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-shield-check fs-4" aria-hidden="true"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-2">2. Réservez au prix juste</h3>
                        <p class="text-muted small mb-0">
                            Le tarif est calculé uniquement sur les segments que vous parcourez et figé dès la réservation. Aucune surréservation possible grâce au verrouillage transactionnel.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4" data-controller="reveal" data-reveal-delay-value="200">
                <div class="card h-100 card-interactive" data-controller="tilt">
                    <div class="card-body p-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3 badge-lime"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-stars fs-4" aria-hidden="true"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-2">3. Voyagez &amp; évaluez</h3>
                        <p class="text-muted small mb-0">
                            En cas de changement d'horaire supérieur à 30 minutes ou d'annulation anticipée (+24h), vous êtes remboursé à 100 %. Échangez un avis vérifié à l'arrivée.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Section 2 : Trajets populaires (avec photos WebP locales des villes + tilt 3D) #}
    <section class="py-2 mb-4" aria-labelledby="popular-trips-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4" data-controller="reveal">
            <div>
                <span class="badge badge-lime mb-2">Axes fréquents</span>
                <h2 id="popular-trips-heading" class="h3 fw-bold mb-0">Trajets populaires au Maroc</h2>
            </div>
            {% if app.user %}
                <a href="{{ path('app_trip_new') }}" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Proposer un trajet
                </a>
            {% endif %}
        </div>

        <div class="row g-4">
            {% if popularTrips is not empty %}
                {% for trip in popularTrips %}
                    {% set stops = trip.stops %}
                    {% if stops|length >= 2 %}
                        <div class="col-12 col-md-6 col-lg-4" data-controller="reveal" data-reveal-delay-value="{{ loop.index0 * 90 }}">
                            <div class="card h-100 card-interactive" data-controller="tilt">
                                <div class="card-body p-4 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="mb-3">
                                            {% include 'components/city_image.html.twig' with {
                                                cityName: stops|last.city.name,
                                                width: 400,
                                                height: 150
                                            } %}
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="badge badge-surface">
                                                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>{{ stops|first.departureTime|date('d/m/Y H:i') }}
                                            </span>
                                            <span class="badge badge-lime">{{ stops|length }} étapes</span>
                                        </div>
                                        <h3 class="h5 fw-bold mb-2">
                                            {{ stops|first.city.name }} &rarr; {{ stops|last.city.name }}
                                        </h3>
                                        <p class="small text-muted mb-3">
                                            {% for s in stops %}
                                                {{ s.city.name }}{% if not loop.last %} &bull; {% endif %}
                                            {% endfor %}
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                        <div>
                                            <div class="small text-muted">
                                                Conducteur : <strong>{{ trip.driver.firstName }} {{ trip.driver.lastName|slice(0, 1)|upper }}.</strong>
                                            </div>
                                            <div class="small text-muted mt-1">
                                                {% set minPrice = null %}
                                                {% for s in stops %}
                                                    {% if loop.index0 > 0 and (minPrice is null or s.priceFromPrevious < minPrice) %}
                                                        {% set minPrice = s.priceFromPrevious %}
                                                    {% endif %}
                                                {% endfor %}
                                                À partir de <span class="fw-bold text-highlight-lime">{{ minPrice ?? '0.00' }} MAD</span>
                                            </div>
                                        </div>
                                        <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="btn btn-outline-light btn-sm">
                                            Détails <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                {% for demo in [
                    {'city': 'Casablanca', 'tag': 'Axe Atlantique & Sud', 'route': 'Agadir → Marrakech → Casablanca', 'price': '120 MAD'},
                    {'city': 'Essaouira', 'tag': 'Route Côtière', 'route': 'Agadir → Essaouira → Safi → El Jadida', 'price': '70 MAD'},
                    {'city': 'Fès', 'tag': 'Axe Impérial', 'route': 'Marrakech → Casablanca → Rabat → Fès', 'price': '50 MAD'}
                ] %}
                    <div class="col-12 col-md-6 col-lg-4" data-controller="reveal" data-reveal-delay-value="{{ loop.index0 * 90 }}">
                        <div class="card h-100 card-interactive" data-controller="tilt">
                            <div class="card-body p-4">
                                <div class="mb-3">
                                    {% include 'components/city_image.html.twig' with {
                                        cityName: demo.city,
                                        width: 400,
                                        height: 150
                                    } %}
                                </div>
                                <span class="badge badge-lime mb-2">{{ demo.tag }}</span>
                                <h3 class="h5 fw-bold">{{ demo.route }}</h3>
                                <p class="small text-muted mb-0">À partir de {{ demo.price }} par portion</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </section>
{% endif %}
{% endblock %}
