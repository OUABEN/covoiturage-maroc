{% extends 'base.html.twig' %}

{% block title %}Profil de {{ profileUser.fullName }} — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center fw-bold fs-2 mb-3" style="width: 72px; height: 72px;">
                    {{ profileUser.firstName|slice(0, 1)|upper }}{{ profileUser.lastName|slice(0, 1)|upper }}
                </div>
                <h1 class="h4 fw-bold mb-1">{{ profileUser.fullName }}</h1>
                <p class="text-muted small mb-3">
                    <i class="bi bi-calendar3 me-1"></i>Membre depuis le {{ profileUser.createdAt|date('d/m/Y') }}
                </p>

                <div class="p-3 rounded bg-light mb-3">
                    {% if ratingSummary.average is not null %}
                        <div class="fs-3 fw-bold text-warning">
                            <i class="bi bi-star-fill me-1"></i>{{ ratingSummary.average|number_format(1, ',', ' ') }} <span class="fs-6 text-muted">/ 5</span>
                        </div>
                        <div class="small text-muted">Basé sur {{ ratingSummary.count }} avis vérifié(s)</div>
                    {% else %}
                        <div class="text-muted small">Aucun avis reçu pour le moment</div>
                    {% endif %}
                </div>

                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="border rounded p-2">
                            <div class="fw-bold fs-5 text-success">{{ completedDriverTripsCount + publishedDriverTripsCount }}</div>
                            <div class="small text-muted">Trajets conducteur</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2">
                            <div class="fw-bold fs-5 text-primary">{{ confirmedBookingsCount }}</div>
                            <div class="small text-muted">Réservations passager</div>
                        </div>
                    </div>
                </div>

                {% if app.user and app.user.id == profileUser.id %}
                    <hr class="my-3">
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_my_trips') }}" class="btn btn-outline-success btn-sm fw-semibold">
                            <i class="bi bi-signpost-split me-1"></i>Gérer mes trajets
                        </a>
                        <a href="{{ path('app_my_bookings') }}" class="btn btn-outline-primary btn-sm fw-semibold">
                            <i class="bi bi-ticket-perforated me-1"></i>Voir mes réservations
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if vehicles is not empty %}
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h6 fw-bold text-uppercase text-muted mb-3">
                        <i class="bi bi-car-front me-1"></i>Véhicule(s) du conducteur
                    </h2>
                    <ul class="list-group list-group-flush">
                        {% for v in vehicles %}
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>{{ v.brand }} {{ v.model }}</strong>
                                    <div class="small text-muted">Couleur : {{ v.color }}</div>
                                </div>
                                <span class="badge bg-light text-dark border">{{ v.seats }} places</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-3">
                    <i class="bi bi-chat-square-quote text-success me-2"></i>Avis reçus ({{ receivedReviews|length }})
                </h2>

                {% if receivedReviews is empty %}
                    <div class="p-4 text-center text-muted bg-light rounded">
                        Cet utilisateur n'a pas encore reçu d'avis.
                    </div>
                {% else %}
                    <div class="vstack gap-3">
                        {% for review in receivedReviews %}
                            <div class="border rounded p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div>
                                        <a href="{{ path('app_profile_show', {id: review.author.id}) }}" class="fw-bold text-decoration-none text-dark">
                                            {{ review.author.fullName }}
                                        </a>
                                        <span class="text-muted small ms-2">
                                            &bull; Portion {{ review.booking.fromStop.city.name }} &rarr; {{ review.booking.toStop.city.name }}
                                        </span>
                                    </div>
                                    <div class="text-warning fw-bold">
                                        {% for i in 1..5 %}
                                            <i class="bi {{ i <= review.rating ? 'bi-star-fill' : 'bi-star' }}"></i>
                                        {% endfor %}
                                        <span class="text-dark small ms-1">({{ review.rating }}/5)</span>
                                    </div>
                                </div>
                                {% if review.comment %}
                                    <p class="mb-1 text-secondary">{{ review.comment }}</p>
                                {% endif %}
                                <div class="small text-muted">
                                    Publié le {{ review.createdAt|date('d/m/Y à H:i') }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
