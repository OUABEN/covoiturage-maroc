{% extends 'base.html.twig' %}

{% block title %}Profil de {{ profileUser.fullName }} — AtlasCovoit Maroc{% endblock %}

{% block body %}
{# Compute 5★ down to 1★ distribution from receivedReviews #}
{% set starCounts = {5: 0, 4: 0, 3: 0, 2: 0, 1: 0} %}
{% for r in receivedReviews %}
    {% set star = r.rating %}
    {% if star >= 1 and star <= 5 %}
        {% set starCounts = starCounts|merge({(star): (starCounts[star] ?? 0) + 1}) %}
    {% endif %}
{% endfor %}
{% set totalReviews = receivedReviews|length %}

<div class="row g-4">
    {# Left Column: Identity Card, Rating Distribution & Driver Fleet #}
    <div class="col-lg-4">
        <div class="card overflow-hidden mb-4">
            <div class="profile-cover" aria-hidden="true"></div>
            <div class="card-body p-4 pt-0 text-center">
                <div class="avatar-xl" aria-hidden="true">
                    {{ profileUser.firstName|slice(0, 1)|upper }}{{ profileUser.lastName|slice(0, 1)|upper }}
                </div>

                <span class="badge badge-lime mb-2">
                    <i class="bi bi-patch-check-fill me-1" aria-hidden="true"></i>Membre vérifié
                </span>

                <h1 class="h3 fw-extrabold mb-1">{{ profileUser.fullName }}</h1>
                <p class="text-muted small mb-4">
                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                    Membre depuis le {{ profileUser.createdAt|date('d/m/Y') }}
                </p>

                {# Rating Hero Score & Animated 5★ → 1★ Distribution Bars #}
                <div class="p-3 rounded-3 border mb-4 text-start" style="background-color: var(--surface-2);">
                    {% if ratingSummary.average is not null %}
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="rating-hero">
                                    {{ ratingSummary.average|number_format(1, ',', ' ') }}
                                    <span class="fs-6 text-muted fw-semibold">/ 5</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Basé sur {{ ratingSummary.count }} avis vérifié(s)
                                </div>
                            </div>
                            <span class="badge badge-lime fs-6">
                                <i class="bi bi-star-fill me-1" aria-hidden="true"></i>Top profil
                            </span>
                        </div>

                        <div class="rating-bars is-revealed" data-reveal>
                            {% for star in [5, 4, 3, 2, 1] %}
                                {% set cnt = starCounts[star] ?? 0 %}
                                {% set pct = totalReviews > 0 ? ((cnt / totalReviews) * 100)|round : 0 %}
                                <div class="rating-bar">
                                    <span>{{ star }} ★</span>
                                    <div class="rating-bar__track">
                                        <div class="rating-bar__fill" style="--w: {{ pct }}%;"></div>
                                    </div>
                                    <span class="text-end text-muted">{{ cnt }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center text-muted small py-2">
                            <i class="bi bi-star me-1" aria-hidden="true"></i>Aucun avis reçu pour le moment
                        </div>
                    {% endif %}
                </div>

                {# Activity KPIs #}
                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="p-3 rounded-3 border" style="background-color: var(--surface-2);">
                            <div class="fw-extrabold fs-4"
                                 data-controller="counter"
                                 data-counter-target-value="{{ completedDriverTripsCount + publishedDriverTripsCount }}">
                                {{ completedDriverTripsCount + publishedDriverTripsCount }}
                            </div>
                            <div class="small text-muted">Trajets conducteur</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 border" style="background-color: var(--surface-2);">
                            <div class="fw-extrabold fs-4"
                                 data-controller="counter"
                                 data-counter-target-value="{{ confirmedBookingsCount }}">
                                {{ confirmedBookingsCount }}
                            </div>
                            <div class="small text-muted">Réservations passager</div>
                        </div>
                    </div>
                </div>

                {% if app.user and app.user.id == profileUser.id %}
                    <hr class="my-4">
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_my_trips') }}" class="btn btn-lime btn-sm">
                            <i class="bi bi-signpost-split me-1" aria-hidden="true"></i>Gérer mes trajets conducteur
                        </a>
                        <a href="{{ path('app_my_bookings') }}" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-ticket-perforated me-1" aria-hidden="true"></i>Voir mes réservations passager
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if vehicles is not empty %}
            <div class="card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h6 fw-extrabold text-uppercase text-muted mb-0">
                            <i class="bi bi-car-front-fill me-1" aria-hidden="true"></i>Véhicule(s) du conducteur
                        </h2>
                        <span class="badge badge-surface">{{ vehicles|length }}</span>
                    </div>
                    <div class="vstack gap-2">
                        {% for v in vehicles %}
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-3 border" style="background-color: var(--surface-2);">
                                <div class="d-flex align-items-center gap-3">
                                    {% include 'components/car_image.html.twig' with {
                                        label: v.brand ~ ' ' ~ v.model,
                                        displayHeight: 40
                                    } %}
                                    <div>
                                        <strong class="d-block">{{ v.brand }} {{ v.model }}</strong>
                                        <span class="small text-muted">Couleur : {{ v.color }}</span>
                                    </div>
                                </div>
                                <span class="badge badge-lime">{{ v.seats }} places</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {# Right Column: Received Verified Reviews #}
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                    <div>
                        <h2 class="h4 fw-extrabold mb-1">
                            <i class="bi bi-chat-square-quote-fill me-2" style="color: var(--accent);" aria-hidden="true"></i>
                            Avis reçus ({{ receivedReviews|length }})
                        </h2>
                        <p class="small text-muted mb-0">
                            Seuls les passagers et conducteurs ayant réellement voyagé ensemble sur un trajet terminé peuvent publier un avis.
                        </p>
                    </div>
                    <span class="badge badge-surface">
                        <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Coordonnées privées protégées
                    </span>
                </div>

                {% if receivedReviews is empty %}
                    <div class="empty-state">
                        <div class="empty-state__art" aria-hidden="true">
                            <i class="bi bi-chat-dots"></i>
                        </div>
                        <h3 class="h5 fw-extrabold mb-1">Aucun avis reçu pour le moment</h3>
                        <p class="text-muted small mb-0">
                            Cet utilisateur n'a pas encore reçu d'évaluation sur un trajet terminé.
                        </p>
                    </div>
                {% else %}
                    <div class="vstack gap-3">
                        {% for review in receivedReviews %}
                            <div class="review-card">
                                <span class="review-card__quote" aria-hidden="true">&ldquo;</span>
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-initials" style="width: 38px; height: 38px; font-size: 0.85rem;" aria-hidden="true">
                                            {{ review.author.firstName|slice(0, 1)|upper }}{{ review.author.lastName|slice(0, 1)|upper }}
                                        </span>
                                        <div>
                                            <a href="{{ path('app_profile_show', {id: review.author.id}) }}" class="fw-extrabold text-decoration-none">
                                                {{ review.author.fullName }}
                                            </a>
                                            <div class="small text-muted">
                                                Portion <strong class="text-white">{{ review.booking.fromStop.city.name }} &rarr; {{ review.booking.toStop.city.name }}</strong>
                                                &bull; {{ review.createdAt|date('d/m/Y à H:i') }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <div class="stars-static" aria-label="Note {{ review.rating }} sur 5">
                                            {% for i in 1..5 %}
                                                <i class="bi {{ i <= review.rating ? 'bi-star-fill' : 'bi-star' }}" aria-hidden="true"></i>
                                            {% endfor %}
                                        </div>
                                        <span class="badge badge-lime">{{ review.rating }}/5</span>
                                    </div>
                                </div>

                                {% if review.comment %}
                                    <p class="mb-0 mt-2">{{ review.comment }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
