{% extends 'base.html.twig' %}

{% block title %}Inscription — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 fw-bold mb-2 text-center">Créer un compte</h1>
                <p class="text-muted text-center small mb-4">
                    Un seul compte vous permet de réserver des places comme passager et de publier vos propres trajets comme conducteur.
                </p>

                {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="row g-3">
                        <div class="col-sm-6">
                            {{ form_row(registrationForm.firstName, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-sm-6">
                            {{ form_row(registrationForm.lastName, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(registrationForm.phone, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>

                    <button type="submit" class="btn btn-brand w-100 py-2 fw-semibold mt-4">
                        <i class="bi bi-person-check me-1"></i>S'inscrire
                    </button>
                {{ form_end(registrationForm) }}

                <hr class="my-4">
                <p class="text-center small mb-0">
                    Déjà inscrit ?
                    <a href="{{ path('app_login') }}" class="fw-semibold text-decoration-none">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
