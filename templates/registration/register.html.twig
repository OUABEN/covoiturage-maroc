{% extends 'base.html.twig' %}

{% block title %}Inscription — AtlasCovoit Maroc{% endblock %}

{% block body %}
<div class="row justify-content-center py-3">
    <div class="col-xl-10">
        <div class="auth-split-card">
            <div class="row g-0">
                {# Left Dark Visual Panel #}
                <div class="col-lg-5 auth-visual-panel">
                    <div>
                        <span class="badge badge-lime mb-3">
                            <i class="bi bi-stars me-1" aria-hidden="true"></i>Inscription gratuite
                        </span>
                        <h2 class="h3 fw-extrabold mb-3">
                            Rejoignez la communauté <span class="text-highlight-lime">AtlasCovoit</span>
                        </h2>
                        <p class="small mb-4" style="color: #A1A1AA;">
                            Un seul profil vérifié pour voyager léger comme passager ET partager vos frais de route comme conducteur.
                        </p>

                        <div class="mb-4">
                            {% include 'components/city_image.html.twig' with {
                                cityName: 'Agadir',
                                height: 155,
                                class: 'w-100 object-fit-cover d-block'
                            } %}
                        </div>

                        <div class="d-grid gap-3 small">
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge badge-lime rounded-circle p-1 mt-1" aria-hidden="true">
                                    <i class="bi bi-person-check-fill"></i>
                                </span>
                                <div>
                                    <strong class="d-block text-white">Profil conducteur &amp; passager unifié</strong>
                                    <span style="color: #A1A1AA;">Publiez vos véhicules ou réservez une étape en 2 clics.</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge badge-lime rounded-circle p-1 mt-1" aria-hidden="true">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <div>
                                    <strong class="d-block text-white">Confidentialité respectée</strong>
                                    <span style="color: #A1A1AA;">Votre e-mail et votre téléphone ne sont jamais exposés publiquement.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 mt-4 border-top" style="border-color: #2A2A2E !important;">
                        <div class="small" style="color: #A1A1AA;">
                            <i class="bi bi-lock-fill me-1" style="color: var(--accent);" aria-hidden="true"></i>
                            Mot de passe haché (bcrypt/argon2i) · Protection CSRF active
                        </div>
                    </div>
                </div>

                {# Right Form Panel with Field-by-Field Validation #}
                <div class="col-lg-7 auth-form-panel">
                    <div class="mb-4">
                        <h1 class="h3 fw-extrabold mb-1">Créer un compte</h1>
                        <p class="text-muted small mb-0">
                            Remplissez vos informations ci-dessous. Tous les champs sont requis.
                        </p>
                    </div>

                    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                        {% if not registrationForm.vars.valid %}
                            <div class="alert alert-danger small mb-3" role="alert">
                                <i class="bi bi-exclamation-octagon-fill me-1" aria-hidden="true"></i>
                                Veuillez corriger les erreurs signalées sous les champs du formulaire.
                            </div>
                        {% endif %}

                        <div class="row g-3">
                            <div class="col-sm-6">
                                {{ form_label(registrationForm.firstName, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.firstName, {
                                    'attr': {
                                        'class': 'form-control' ~ (registrationForm.firstName.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'Ex. Amina'
                                    }
                                }) }}
                                <div class="form-error-list">
                                    {{ form_errors(registrationForm.firstName) }}
                                </div>
                            </div>

                            <div class="col-sm-6">
                                {{ form_label(registrationForm.lastName, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.lastName, {
                                    'attr': {
                                        'class': 'form-control' ~ (registrationForm.lastName.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'Ex. El Fassi'
                                    }
                                }) }}
                                <div class="form-error-list">
                                    {{ form_errors(registrationForm.lastName) }}
                                </div>
                            </div>

                            <div class="col-12">
                                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.email, {
                                    'attr': {
                                        'class': 'form-control' ~ (registrationForm.email.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'amina.elfassi@covoiturage.ma'
                                    }
                                }) }}
                                <div class="form-error-list">
                                    {{ form_errors(registrationForm.email) }}
                                </div>
                            </div>

                            <div class="col-12">
                                {{ form_label(registrationForm.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.phone, {
                                    'attr': {
                                        'class': 'form-control' ~ (registrationForm.phone.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': '+212 6 61 00 11 22'
                                    }
                                }) }}
                                <div class="form-error-list">
                                    {{ form_errors(registrationForm.phone) }}
                                </div>
                            </div>

                            <div class="col-12">
                                {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.plainPassword, {
                                    'attr': {
                                        'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'Minimum 8 caractères'
                                    }
                                }) }}
                                <div class="form-text small text-muted mt-1">
                                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>8 caractères minimum requis.
                                </div>
                                <div class="form-error-list">
                                    {{ form_errors(registrationForm.plainPassword) }}
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-lime w-100 py-3 mt-4">
                            <i class="bi bi-person-check-fill me-1" aria-hidden="true"></i>S'inscrire
                        </button>
                    {{ form_end(registrationForm) }}

                    <hr class="my-4">
                    <p class="text-center small mb-0">
                        Vous avez déjà un compte ?
                        <a href="{{ path('app_login') }}" class="fw-extrabold text-decoration-underline ms-1">Se connecter</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
