{#
    Reusable Vehicle Visual Component
    Uses a clean dark gradient badge fallback when no photorealistic car image is present (never a broken image).
#}
<span class="d-inline-flex align-items-center justify-content-center rounded-3 px-2 py-1"
      style="height: {{ displayHeight ?? 36 }}px; background: linear-gradient(135deg, #0B0B0C 0%, #1C1C1F 100%); border: 1px solid var(--border); color: var(--accent);"
      title="{{ label ?? 'Véhicule de covoiturage' }}">
    <i class="bi bi-car-front-fill" aria-hidden="true"></i>
</span>
