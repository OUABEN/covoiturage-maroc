{#
    Reusable Vehicle Image Component (with 2-size WebP srcset + fallback)
    Parameters:
    - seats: int (default 4)
    - label: string (default 'Véhicule de covoiturage')
    - width: int (default 320)
    - height: int (default 200)
#}
{% set carSlug = (seats ?? 4) >= 6 ? 'mpv' : ((seats ?? 4) == 5 ? 'suv' : 'sedan') %}
<img src="/images/cars/{{ carSlug }}.webp"
     srcset="/images/cars/{{ carSlug }}-sm.webp 320w, /images/cars/{{ carSlug }}.webp 640w"
     sizes="(max-width: 768px) 160px, 320px"
     width="{{ width ?? 320 }}"
     height="{{ height ?? 200 }}"
     loading="lazy"
     decoding="async"
     alt="Silhouette illustrée du véhicule ({{ label ?? 'berline de covoiturage' }})"
     class="{{ class ?? 'rounded-3 object-fit-cover' }}"
     style="height: {{ displayHeight ?? 56 }}px; width: auto; border: 1px solid var(--border);">
