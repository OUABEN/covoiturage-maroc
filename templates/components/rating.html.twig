{#
    Reusable Rating Component (Lime Stars)
    Parameters:
    - average: float|null
    - count: int (default 0)
    - showNewLabel: bool (default true)
#}
{% if average is not null %}
    <span class="d-inline-flex align-items-center gap-1">
        <i class="bi bi-star-fill" style="color: var(--accent);" aria-hidden="true"></i>
        <strong class="text-white">{{ average|number_format(1, '.', ' ') }}/5</strong>
        <span class="text-muted small">({{ count ?? 0 }} avis)</span>
    </span>
{% elseif showNewLabel ?? true %}
    <span class="text-muted small">Nouveau conducteur</span>
{% endif %}
