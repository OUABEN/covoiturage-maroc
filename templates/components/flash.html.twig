{#
    Reusable Flash Messages / Toasts Component
    Preserves .alert-success and .alert-danger selectors for functional WebTestCase assertions
#}
{% for label, messages in app.flashes %}
    {% set bsClass = label == 'error' ? 'danger' : label %}
    {% set iconClass = {
        'success': 'check-circle-fill',
        'danger': 'exclamation-triangle-fill',
        'warning': 'exclamation-circle-fill',
        'info': 'info-circle-fill',
    }[bsClass] ?? 'info-circle-fill' %}
    {% for message in messages %}
        <div class="alert alert-{{ bsClass }} alert-dismissible fade show d-flex align-items-center justify-content-between gap-3 mb-3 animate-fade-up" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-{{ iconClass }} fs-5" style="color: {{ bsClass == 'danger' ? 'var(--danger)' : 'var(--accent)' }};" aria-hidden="true"></i>
                <div class="fw-semibold">{{ message }}</div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}
{% endfor %}
